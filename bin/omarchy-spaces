TIME_RE = re.compile(r"^([01]?\d|2[0-3]):([0-5]\d)$")


# --- safe file reads ---------------------------------------------------------
#
# The shell plugin is a long-lived process, so anything it reads has to be
# bounded and cannot be allowed to block. A plain `cat` is neither: it follows
# symlinks, blocks forever on a FIFO, and will happily stream a file larger
# than memory into a collector.
#
# Every read of a replaceable path goes through here instead:
#
#   O_NOFOLLOW   a symlink in place of the file fails rather than redirecting
#                the read somewhere else
#   O_NONBLOCK   opening a FIFO or a device returns immediately instead of
#                waiting for a writer that may never come
#   fstat on the same descriptor, not a second stat of the path, so the file
#                checked is the file read and there is no window between them
#   regular file, owner, and byte limit enforced before and during the read
#
# Rejections are not errors to recover from. The caller keeps whatever it last
# parsed successfully, which is the safe direction to fail in.

READ_LIMIT_CONFIG = 1 << 20      # 1 MiB, generous for JSON with many spaces
READ_LIMIT_STATE = 4096          # a space id and a newline

_READ_TARGETS = {
    "config": lambda: (CONFIG_PATH, READ_LIMIT_CONFIG),
    "active": lambda: (ACTIVE_PATH, READ_LIMIT_STATE),
}


def safe_read(path, limit):
    """Read a regular file you own, up to limit bytes. Returns (text, reason)."""
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
    flags |= getattr(os, "O_NONBLOCK", 0)
    try:
        fd = os.open(path, flags)
    except OSError as e:
        if e.errno == errno.ELOOP:
            return None, "is a symlink"
        if e.errno == errno.ENOENT:
            return None, "does not exist"
        return None, "could not be opened: %s" % e.strerror
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            return None, "is not a regular file"
        if st.st_uid != os.getuid():
            return None, "is not owned by you"
        if st.st_size > limit:
            return None, "is larger than %d bytes" % limit
        chunks, total = [], 0
        while True:
            try:
                chunk = os.read(fd, 65536)
            except BlockingIOError:
                return None, "would block"
            if not chunk:
                break
            total += len(chunk)
            # Checked while reading too: st_size is a snapshot and a file can
            # grow between the stat and the last read.
            if total > limit:
                return None, "is larger than %d bytes" % limit
            chunks.append(chunk)
    finally:
        os.close(fd)
    return b"".join(chunks).decode("utf-8", "replace"), None


def cmd_read_file(cfg_unused, args):
    """Bounded read of one of this plugin's own files, for the shell plugin.

    The plugin runs this instead of `cat` so the long-lived shell never reads
    something unbounded, blocking, or redirected by a symlink.
    """
    what = args[0] if args else ""
    if what not in _READ_TARGETS:
        die("usage: omarchy-spaces read-file <config|active>")
    path, limit = _READ_TARGETS[what]()
    text, reason = safe_read(path, limit)
    if reason is not None:
        print("%s %s" % (path, reason), file=sys.stderr)
        return 1
    sys.stdout.write(text)
    return 0


def die(msg, code=1):
    print("omarchy-spaces: " + msg, file=sys.stderr)
    sys.exit(code)


def load_config():
    if not os.path.exists(CONFIG_PATH):
        die("no config at %s\nRun: omarchy-spaces init" % CONFIG_PATH, 2)
    text, reason = safe_read(CONFIG_PATH, READ_LIMIT_CONFIG)
    if reason is not None:
        die("config at %s %s" % (CONFIG_PATH, reason), 2)
    try:
        cfg = json.loads(text)
    except json.JSONDecodeError as e:
        die("config is not valid JSON: %s" % e, 2)
    if not isinstance(cfg.get("spaces"), list) or not cfg["spaces"]:
        die("config has no spaces", 2)
    return cfg



# --- defaults inheritance ----------------------------------------------------
#
# A top-level `defaults` object supplies values for every space. A space
# overrides what it sets and inherits the rest, so a shared schedule, browser,
# or workspace count is written once instead of per space.
#
# Objects merge recursively. Arrays and scalars are replaced whole, because a
# half-inherited list is harder to reason about than an explicit one. Identity
# fields are never inherited. Mirrors resolveSpace in SpacesLogic.js.

IDENTITY_KEYS = ("id", "name", "icon", "color")


def deep_merge(base, override):
    if not isinstance(base, dict):
        return override
    if not isinstance(override, dict):
        return base if override is None else override
    out = dict(base)
    for k, v in override.items():
        if isinstance(out.get(k), dict) and isinstance(v, dict):
            out[k] = deep_merge(out[k], v)
        else:
            out[k] = v
    return out


def resolve_space(cfg, space_id):
    space = find_space(cfg, space_id)
    if space is None:
        return None
    defaults = cfg.get("defaults")
    if not isinstance(defaults, dict):
        return space
    base = {k: v for k, v in defaults.items() if k not in IDENTITY_KEYS}
    return deep_merge(base, space)


def inherited_keys(cfg, space_id):
    space = find_space(cfg, space_id)
    defaults = cfg.get("defaults")
    if space is None or not isinstance(defaults, dict):
        return []
    return [k for k in defaults
            if k not in IDENTITY_KEYS and space.get(k) is None and k not in space]


def parse_time(value):
    if not isinstance(value, str):
        return None
    m = TIME_RE.match(value.strip())
    if not m:
        return None
    return int(m.group(1)) * 60 + int(m.group(2))


def window_contains(win, now):
    frm = parse_time((win or {}).get("from"))
    to = parse_time((win or {}).get("to"))
    if frm is None or to is None:
        return False
    if frm == to:
        return True
    if frm < to:
        return frm <= now < to
    return now >= frm or now < to


def normalize_list(value):
    if not isinstance(value, list):
        return []
    out = []
    for item in value:
        s = str(item or "").strip()
        if s and s not in out:
            out.append(s)
    return out


def space_ids(cfg):
    return [str(s["id"]) for s in cfg.get("spaces", []) if s.get("id")]


def find_space(cfg, space_id):
    for s in cfg.get("spaces", []):
        if str(s.get("id")) == str(space_id):
            return s
    return None


def normalize_app_key(name):
    s = str(name or "").strip().lower()
    if s.endswith(".desktop"):
        s = s[:-8]
    return s


def app_entry(raw):
    """Normalise one `apps` entry.

    Either a bare string, or an object. The string form covers the common case
    where the notification name and the window class are the same text.

        "Signal"
        {"name": "Steam", "class": "steam", "slot": 2}

    `name` matches the app_name a notification carries. `class` matches the
    Hyprland window class, which is often but not always the same string.
    `slot` is which workspace of the owning space its windows open on.
    Mirrors appEntry in SpacesLogic.js.
    """
    if isinstance(raw, str):
        name = raw.strip()
        return ({"name": name, "cls": name, "slot": 1,
                 "windowRule": True, "shared": False} if name else None)
    if isinstance(raw, dict):
        name = str(raw.get("name") or raw.get("class") or "").strip()
        if not name:
            return None
        try:
            slot = int(raw.get("slot", 1))
        except (TypeError, ValueError):
            slot = 1
        return {"name": name,
                "cls": str(raw.get("class") or name).strip(),
                "slot": slot if slot > 0 else 1,
                "windowRule": raw.get("windowRule") is not False,
                # A shared app belongs to no single space. Its notifications
                # always get through and its windows are never forced anywhere,
                # which is what a music player or a password manager wants.
                "shared": raw.get("shared") is True}
    return None


def app_entries(space):
    out = []
    for raw in ((space or {}).get("apps") or []):
        e = app_entry(raw)
        if e:
            out.append(e)
    return out


def space_for_app(cfg, app):
    key = normalize_app_key(app)
    if not key:
        return None
    for sid in space_ids(cfg):
        for entry in app_entries(resolve_space(cfg, sid)):
            if entry.get("shared"):
                continue
            if normalize_app_key(entry["name"]) == key:
                return sid
    # Shared apps belong to nobody on purpose, so they never fall back.
    if is_shared_app(cfg, app):
        return None
    return fallback_space(cfg)


def fallback_space(cfg):
    """The space that owns anything no space claims explicitly.

    Without it every app has to be listed somewhere or it counts as unassigned.
    With it one space is the home for everything else, and only the exceptions
    need naming.
    """
    sid = cfg.get("fallbackSpace")
    return str(sid) if sid and find_space(cfg, sid) else None


def shared_app_entries(cfg):
    """Every app marked shared, from defaults and from every space.

    Read from `defaults.apps` directly rather than through resolve_space,
    because arrays replace on inherit: a space with its own apps list would
    otherwise never see a shared entry declared in defaults, which is the one
    place people will put a music player.
    """
    out = []
    sources = []
    if isinstance(cfg.get("defaults"), dict):
        sources.append(cfg["defaults"])
    sources.extend(cfg.get("spaces", []))
    for src in sources:
        out.extend(e for e in app_entries(src) if e.get("shared"))
    return out


def is_shared_app(cfg, app):
    key = normalize_app_key(app)
    if not key:
        return False
    return any(normalize_app_key(e["name"]) == key for e in shared_app_entries(cfg))


def resolve_policy(cfg, space_id, now):
    space = resolve_space(cfg, space_id)
    if space is None:
        return {"allowFrom": space_ids(cfg), "source": "no-space",
                "window": None, "allowUnassigned": True}
    notif = space.get("notifications") or {}
    baseline = normalize_list(notif.get("allowFrom"))
    allow_unassigned = notif.get("allowUnassigned") is not False
    for win in (notif.get("schedule") or []):
        if window_contains(win, now):
            wu = win.get("allowUnassigned")
            return {
                "allowFrom": normalize_list(win.get("allowFrom")),
                "source": "schedule",
                "window": {"from": win.get("from"), "to": win.get("to"),
                           "label": win.get("label", "")},
                "allowUnassigned": (wu is not False) if wu is not None else allow_unassigned,
            }
    return {"allowFrom": baseline, "source": "baseline",
            "window": None, "allowUnassigned": allow_unassigned}


def minutes_now():
    n = datetime.now()
    return n.hour * 60 + n.minute


def read_active(cfg):
    text, reason = safe_read(ACTIVE_PATH, READ_LIMIT_STATE)
    if reason is None:
        val = text.strip()
        if find_space(cfg, val):
            return val
    fallback = cfg.get("activeSpace")
    if find_space(cfg, fallback):
        return str(fallback)
    return space_ids(cfg)[0]


def write_active(space_id):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = ACTIVE_PATH + ".tmp"
    with open(tmp, "w") as fh:
        fh.write(str(space_id) + "\n")
    os.replace(tmp, ACTIVE_PATH)


def notify(cfg, space):
    if cfg.get("switchNotification") is False:
        return
    icon = space.get("icon") or ""
    name = space.get("name") or space.get("id")
    for cmd in (["omarchy-notification-send", "-g", icon, "Space: %s" % name],
                ["notify-send", "-a", "omarchy-spaces", "Space: %s" % name]):
        try:
            subprocess.run(cmd, check=True, capture_output=True, timeout=5)
            return
        except (OSError, subprocess.SubprocessError):
            continue


def run_hooks(cfg, space_id, previous):
    hook_dir = os.path.join(CONFIG_HOME, "omarchy-spaces", "hooks")
    if not os.path.isdir(hook_dir):
        return
    env = dict(os.environ)
    env["OMARCHY_SPACE"] = str(space_id)
    env["OMARCHY_SPACE_PREVIOUS"] = str(previous or "")
    for name in sorted(os.listdir(hook_dir)):
        path = os.path.join(hook_dir, name)
        if os.path.isfile(path) and os.access(path, os.X_OK):
            try:
                subprocess.run([path], env=env, timeout=15, capture_output=True)
            except (OSError, subprocess.SubprocessError):
                pass


# --- commands ---------------------------------------------------------------

def cmd_list(cfg, args):
    active = read_active(cfg)
    for s in cfg["spaces"]:
        mark = "*" if str(s["id"]) == active else " "
        print("%s %-12s %-16s %s" % (mark, s["id"], s.get("name", ""), s.get("email", "")))
    return 0


def cmd_current(cfg, args):
    active = read_active(cfg)
    if args and args[0] == "--json":
        print(json.dumps(find_space(cfg, active)))
    else:
        print(active)
    return 0


def cmd_switch(cfg, args):
    if not args:
        die("usage: omarchy-spaces switch <space-id>")
    target = args[0]
    space = find_space(cfg, target)
    if space is None:
        die("no such space: %s (have: %s)" % (target, ", ".join(space_ids(cfg))))
    previous = read_active(cfg)
    if isolation_on(cfg):
        remember_current_slot(cfg, previous)
    write_active(target)
    if isolation_on(cfg):
        focus_space_workspace(cfg, target)
    apply_appearance(cfg, space)
    run_hooks(cfg, target, previous)
    notify(cfg, space)
    print(target)
    return 0


def cmd_cycle(cfg, args, step):
    ids = space_ids(cfg)
    active = read_active(cfg)
    idx = ids.index(active) if active in ids else 0
    return cmd_switch(cfg, [ids[(idx + step) % len(ids)]])


def cmd_status(cfg, args):
    active = read_active(cfg)
    space = resolve_space(cfg, active)
    now = minutes_now()
    pol = resolve_policy(cfg, active, now)
    if args and args[0] == "--json":
        print(json.dumps({"active": active, "now": now, "policy": pol}, indent=2))
        return 0
    print("space      %s (%s)" % (space.get("name", active), active))
    print("email      %s" % space.get("email", "(none)"))
    br = space.get("browser") or {}
    print("browser    %s profile=%s" % (br.get("command", "(none)"), br.get("profile", "(none)")))
    print("time       %02d:%02d" % (now // 60, now % 60))
    if pol["window"]:
        print("window     %s to %s  %s" % (pol["window"]["from"], pol["window"]["to"],
                                           pol["window"].get("label", "")))
    else:
        print("window     none, using baseline")
    allowed = ", ".join(pol["allowFrom"]) if pol["allowFrom"] else "(nothing)"
    print("allowing   %s" % allowed)
    fb = fallback_space(cfg)
    if fb:
        owner = find_space(cfg, fb) or {}
        allowed = fb in pol["allowFrom"]
        print("unlisted   owned by %s, %s here"
              % (owner.get("name") or fb, "shown" if allowed else "hidden"))
    else:
        print("unlisted   %s" % ("shown" if pol["allowUnassigned"] else "hidden"))
    return 0


def cmd_open(cfg, args):
    if not args:
        die("usage: omarchy-spaces open <url>")
    url = args[0]
    active = read_active(cfg)
    space = resolve_space(cfg, active)
    browser = (space or {}).get("browser") or {}
    if not browser.get("command"):
        os.execvp("xdg-open", ["xdg-open", url])
    argv = [str(browser["command"])]
    argv += normalize_list(browser.get("args"))
    if browser.get("profile"):
        argv.append("--profile-directory=" + str(browser["profile"]))
    argv.append(url)
    os.execvp(argv[0], argv)


def cmd_which(cfg, args):
    """Print the argv that `open` would exec, without running it."""
    url = args[0] if args else "URL"
    active = read_active(cfg)
    space = resolve_space(cfg, active)
    browser = (space or {}).get("browser") or {}
    if not browser.get("command"):
        print(json.dumps(["xdg-open", url]))
        return 0
    argv = [str(browser["command"])]
    argv += normalize_list(browser.get("args"))
    if browser.get("profile"):
        argv.append("--profile-directory=" + str(browser["profile"]))
    argv.append(url)
    print(json.dumps(argv))
    return 0


def cmd_get(cfg, args):
    """Read one field off the active space, for scripts and shell prompts."""
    if not args:
        die("usage: omarchy-spaces get <email|name|icon|color|id|assistant.<tool>>")
    active = read_active(cfg)
    space = resolve_space(cfg, active) or {}
    key = args[0]
    if key.startswith("assistant."):
        val = (space.get("assistants") or {}).get(key.split(".", 1)[1], "")
    else:
        val = space.get(key, "")
    print(val if val is not None else "")
    return 0


def cmd_init(cfg_unused, args):
    target_dir = os.path.dirname(CONFIG_PATH)
    os.makedirs(target_dir, exist_ok=True)
    if os.path.exists(CONFIG_PATH) and "--force" not in args:
        die("config already exists at %s (use --force to overwrite)" % CONFIG_PATH)
    with open(CONFIG_PATH, "w") as dst:
        dst.write(DEFAULT_CONFIG)
    print("wrote %s" % CONFIG_PATH)
    return 0


def cmd_validate(cfg, args):
    problems = []
    ids = space_ids(cfg)
    if len(set(ids)) != len(ids):
        problems.append("duplicate space ids")
    for s in cfg["spaces"]:
        sid = s.get("id", "(missing id)")
        notif = s.get("notifications") or {}
        for ref in normalize_list(notif.get("allowFrom")):
            if ref not in ids:
                problems.append("%s: allowFrom references unknown space '%s'" % (sid, ref))
        wins = notif.get("schedule") or []
        for w in wins:
            if parse_time(w.get("from")) is None or parse_time(w.get("to")) is None:
                problems.append("%s: bad window %s to %s" % (sid, w.get("from"), w.get("to")))
            for ref in normalize_list(w.get("allowFrom")):
                if ref not in ids:
                    problems.append("%s: window allowFrom references unknown space '%s'" % (sid, ref))
        if wins:
            gaps = [m for m in range(1440)
                    if sum(1 for w in wins if window_contains(w, m)) == 0]
            overlaps = [m for m in range(1440)
                        if sum(1 for w in wins if window_contains(w, m)) > 1]
            if gaps:
                problems.append("%s: %d minutes fall in no window, baseline applies there "
                                "(first at %02d:%02d)" % (sid, len(gaps), gaps[0] // 60, gaps[0] % 60))
            if overlaps:
                problems.append("%s: %d minutes match more than one window, the first wins "
                                "(first at %02d:%02d)" % (sid, len(overlaps),
                                                          overlaps[0] // 60, overlaps[0] % 60))
    # With a defaults block, an app list can reach several spaces at once. The
    # first space wins, which is fine but worth saying out loud rather than
    # letting someone wonder why a notification went to the wrong space.
    owners = {}
    for sid in ids:
        for entry in app_entries(resolve_space(cfg, sid)):
            if entry.get("shared"):
                continue
            owners.setdefault(normalize_app_key(entry["name"]), []).append(sid)
    for app, claimers in owners.items():
        if len(claimers) > 1:
            problems.append("app '%s' is claimed by %s; %s wins"
                            % (app, " and ".join(claimers), claimers[0]))

    # A browser is per space through profiles, and every profile shares one
    # window class, so a rule on that class drags every profile's windows into
    # one space. Worth saying rather than letting someone debug it.
    browser_cmds = set()
    for sid in ids:
        cmd = ((resolve_space(cfg, sid) or {}).get("browser") or {}).get("command")
        if cmd:
            browser_cmds.add(normalize_app_key(os.path.basename(str(cmd))))
    for sid in ids:
        for entry in app_entries(resolve_space(cfg, sid)):
            if not entry.get("windowRule", True):
                continue
            cls = normalize_app_key(entry["cls"])
            if cls in browser_cmds or cls.replace("-browser", "") in browser_cmds:
                problems.append(
                    "%s: '%s' is a browser used by a space; a window rule on it would "
                    "pull every profile into %s. Set \"windowRule\": false on that entry "
                    "to keep notification routing without the placement."
                    % (sid, entry["cls"], sid))

    # Overlapping workspace ranges would put two spaces' windows in the same
    # place, which defeats the isolation entirely.
    if isolation_on(cfg):
        seen = {}
        for sid in ids:
            off = ws_offset(cfg, sid)
            for slot in range(1, ws_count(cfg, sid) + 1):
                real = off + slot
                if real in seen:
                    problems.append("%s and %s both claim real workspace %d"
                                    % (seen[real], sid, real))
                    break
                seen[real] = sid
            if off < 0:
                problems.append("%s has a negative workspace offset" % sid)

    if problems:
        for p in problems:
            print("warn: " + p)
        return 1
    print("config is valid, %d spaces" % len(ids))
    if isolation_on(cfg):
        for sid in ids:
            off = ws_offset(cfg, sid)
            print("  %-12s real workspaces %d-%d" % (sid, off + 1, off + ws_count(cfg, sid)))
    return 0




# --- hyprland workspace isolation -------------------------------------------
#
# Each space owns a contiguous range of real Hyprland workspaces. Personal gets
# 1 to 10, work gets 11 to 20, and so on. Windows are never moved on a switch,
# which is what makes switching instant and free of races. "Workspace 1" simply
# means a different real workspace depending on which space is active.
#
# Only the Lua dispatcher form works on Omarchy 4. The classic string form
# ("hyprctl dispatch workspace 3") is a syntax error there.

DEFAULT_WS_COUNT = 10


def hypr(expr):
    try:
        p = subprocess.run(["hyprctl", "dispatch", expr],
                           capture_output=True, text=True, timeout=5)
        out = (p.stdout or "").strip()
        if out and out != "ok":
            return False, out
        return p.returncode == 0, out
    except (OSError, subprocess.SubprocessError) as e:
        return False, str(e)


def hypr_json(what):
    try:
        p = subprocess.run(["hyprctl", "-j", what], capture_output=True, text=True, timeout=5)
        return json.loads(p.stdout)
    except Exception:
        return None


def isolation_on(cfg):
    return cfg.get("workspaceIsolation") is not False


def ws_count(cfg, space_id):
    space = resolve_space(cfg, space_id) or {}
    return int((space.get("workspaces") or {}).get("count", DEFAULT_WS_COUNT))


def ws_offset(cfg, space_id):
    """First real workspace belonging to a space.

    An explicit offset in the config wins. Otherwise it is derived from the
    space's position in the list, so isolation works with no extra config.
    """
    space = resolve_space(cfg, space_id)
    if space is None:
        return 0
    ws = space.get("workspaces") or {}
    if "offset" in ws:
        return int(ws["offset"])
    idx = space_ids(cfg).index(str(space_id))
    return idx * ws_count(cfg, space_id)


def ws_slot_path(space_id):
    return os.path.join(STATE_DIR, "ws-" + str(space_id))


def read_slot(space_id, default=1):
    try:
        with open(ws_slot_path(space_id)) as fh:
            n = int(fh.read().strip())
        return n if n >= 1 else default
    except (OSError, ValueError):
        return default


def write_slot(space_id, n):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = ws_slot_path(space_id) + ".tmp"
    with open(tmp, "w") as fh:
        fh.write(str(int(n)) + "\n")
    os.replace(tmp, ws_slot_path(space_id))


def current_real_ws():
    d = hypr_json("activeworkspace")
    try:
        return int(d["id"])
    except Exception:
        return None


def remember_current_slot(cfg, space_id):
    """Store which slot of its own range the space was last on."""
    real = current_real_ws()
    if real is None:
        return
    off = ws_offset(cfg, space_id)
    slot = real - off
    if 1 <= slot <= ws_count(cfg, space_id):
        write_slot(space_id, slot)


def focus_space_workspace(cfg, space_id):
    off = ws_offset(cfg, space_id)
    slot = read_slot(space_id)
    ok, err = hypr('hl.dsp.focus({ workspace = "%d" })' % (off + slot))
    if not ok:
        print("omarchy-spaces: could not switch workspace: %s" % err, file=sys.stderr)




# --- appearance --------------------------------------------------------------
#
# Each space can pin a theme, a monospace font, and a background. Applying them
# on switch makes the current context obvious at a glance, which is the whole
# point of having spaces in the first place.
#
# These shell out to the stock omarchy commands rather than writing theme files
# directly, so anything Omarchy supports keeps working.


def omarchy(*args, timeout=25):
    try:
        p = subprocess.run(["omarchy", *args], capture_output=True, text=True, timeout=timeout)
        return p.returncode == 0, (p.stdout + p.stderr).strip()
    except (OSError, subprocess.SubprocessError) as e:
        return False, str(e)


def current_appearance():
    out = {}
    ok, v = omarchy("theme", "current", timeout=10)
    if ok and v:
        out["theme"] = v.splitlines()[0].strip()
    ok, v = omarchy("font", "current", timeout=10)
    if ok and v:
        out["font"] = v.splitlines()[0].strip()
    # `omarchy theme bg current` prints a prettified display name, not a path,
    # and `bg set` needs a path. The state symlink is the real answer.
    #
    # Backgrounds live in ~/.local/state/omarchy/current/theme/backgrounds/,
    # whose contents are replaced when the theme changes. Storing that absolute
    # path would silently point at the next theme's image, so a background that
    # belongs to a theme is stored as a bare filename and resolved after the
    # theme is applied. Anything outside that directory is stored as a path.
    link = os.path.join(STATE_HOME, "omarchy", "current", "background")
    try:
        real = os.path.realpath(link)
    except OSError:
        return out
    if not real or not os.path.exists(real):
        return out
    theme_bgs = os.path.join(STATE_HOME, "omarchy", "current", "theme", "backgrounds")
    out["background"] = (os.path.basename(real)
                         if os.path.dirname(real) == theme_bgs else real)
    return out


def resolve_background(value):
    """Turn a stored background into a path that exists, or None."""
    if not value:
        return None
    if os.path.isabs(value):
        return value if os.path.exists(value) else None
    candidate = os.path.join(STATE_HOME, "omarchy", "current", "theme", "backgrounds", value)
    return candidate if os.path.exists(candidate) else None


def apply_appearance(cfg, space):
    """Apply a space's pinned look.

    Theme first, because setting a theme also resets the background, so a
    pinned background has to be applied after it to survive.
    """
    if cfg.get("applyAppearance") is False:
        return
    ap = (space or {}).get("appearance") or {}
    if not ap:
        return
    if ap.get("theme"):
        omarchy("theme", "set", str(ap["theme"]))
    if ap.get("font"):
        omarchy("font", "set", str(ap["font"]))
    if ap.get("background"):
        path = resolve_background(os.path.expanduser(str(ap["background"])))
        if path:
            omarchy("theme", "bg", "set", path)


def cmd_appearance(cfg, args):
    sub = args[0] if args else "show"
    active = read_active(cfg)
    space = find_space(cfg, active)

    if sub == "show":
        ap = (space or {}).get("appearance") or {}
        cur = current_appearance()
        print("space   %s" % active)
        for key in ("theme", "font", "background"):
            pinned = ap.get(key) or "(not pinned)"
            print("  %-11s pinned=%-28s now=%s" % (key, pinned, cur.get(key, "?")))
        return 0

    if sub == "capture":
        cur = current_appearance()
        if not cur:
            die("could not read the current theme, font, or background")
        space["appearance"] = cur
        save_config_file(cfg)
        print("saved to %s:" % active)
        for k, v in cur.items():
            print("  %-11s %s" % (k, v))
        return 0

    if sub == "clear":
        if space and "appearance" in space:
            del space["appearance"]
            save_config_file(cfg)
        print("cleared the pinned look for %s" % active)
        return 0

    if sub == "apply":
        apply_appearance(cfg, space)
        print("applied %s" % active)
        return 0

    die("usage: omarchy-spaces appearance [show|capture|apply|clear]")


def save_config_file(cfg):
    tmp = CONFIG_PATH + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(cfg, fh, indent=2)
        fh.write("\n")
    os.replace(tmp, CONFIG_PATH)


def move_expr(real_ws, follow=True, address=None):
    """Build the Lua dispatcher call for moving a window to a workspace.

    Without an address this acts on whatever Hyprland considers active, which
    is what a hotkey wants. With one it is deterministic, which is what a
    script or the config app wants.
    """
    parts = ['workspace = "%d"' % real_ws]
    if address:
        parts.append('window = "address:%s"' % address)
    if not follow:
        parts.append("follow = false")
    return "hl.dsp.window.move({ %s })" % ", ".join(parts)


def arg_value(args, flag):
    """Read `--flag value` out of an arg list."""
    if flag in args:
        i = args.index(flag)
        if i + 1 < len(args):
            return args[i + 1]
    for a in args:
        if a.startswith(flag + "="):
            return a.split("=", 1)[1]
    return None


def occupied_slots(cfg, space_id):
    """Slots of a space that currently hold windows."""
    data = hypr_json("workspaces") or []
    offset = ws_offset(cfg, space_id)
    count = ws_count(cfg, space_id)
    out = set()
    for w in data:
        try:
            slot = int(w["id"]) - offset
        except (KeyError, TypeError, ValueError):
            continue
        if 1 <= slot <= count and int(w.get("windows", 0)) > 0:
            out.add(slot)
    return out


def relative_slot(cfg, space_id, step):
    """The next or previous slot within a space, wrapping inside its range.

    Hyprland's own e+1 and e-1 walk every workspace on the machine, which is
    why plain relative navigation escapes into another space's range. This
    stays inside the active space.

    Occupied slots are preferred, matching what e+1 does, so navigation skips
    the empty ones. When nothing else is occupied it falls back to a plain
    step so the keys still do something.
    """
    count = ws_count(cfg, space_id)
    offset = ws_offset(cfg, space_id)
    current = read_slot(space_id)
    real = current_real_ws()
    if real is not None and 1 <= real - offset <= count:
        current = real - offset

    occupied = sorted(occupied_slots(cfg, space_id) | {current})
    if len(occupied) > 1:
        i = occupied.index(current) if current in occupied else 0
        return occupied[(i + step) % len(occupied)]
    return ((current - 1 + step) % count) + 1


def cmd_workspace(cfg, args):
    """Go to slot N of the active space's range."""
    if not args:
        die("usage: omarchy-spaces workspace <n|next|prev>")
    active = read_active(cfg)
    if args[0] in ("next", "prev"):
        n = relative_slot(cfg, active, 1 if args[0] == "next" else -1)
    else:
        try:
            n = int(args[0])
        except ValueError:
            die("workspace takes a number, or next or prev")
    count = ws_count(cfg, active)
    if not (1 <= n <= count):
        die("space '%s' has slots 1 to %d" % (active, count))
    write_slot(active, n)
    target = ws_offset(cfg, active) + n
    ok, err = hypr('hl.dsp.focus({ workspace = "%d" })' % target)
    if not ok:
        die("hyprctl failed: %s" % err)
    return 0


def cmd_move_to_workspace(cfg, args):
    """Move the focused window to slot N of the active space, and follow it."""
    if not args:
        die("usage: omarchy-spaces move-to-workspace <n|next|prev>")
    active = read_active(cfg)
    if args[0] in ("next", "prev"):
        n = relative_slot(cfg, active, 1 if args[0] == "next" else -1)
    else:
        try:
            n = int(args[0])
        except ValueError:
            die("move-to-workspace takes a number, or next or prev")
    count = ws_count(cfg, active)
    if not (1 <= n <= count):
        die("space '%s' has slots 1 to %d" % (active, count))
    follow = "--stay" not in args
    target = ws_offset(cfg, active) + n
    ok, err = hypr(move_expr(target, follow, arg_value(args, "--address")))
    if not ok:
        die("hyprctl failed: %s" % err)
    if follow:
        write_slot(active, n)
    return 0


def cmd_move_to_space(cfg, args):
    """Send the focused window to another space.

    This is the escape hatch for a window opened in the wrong context. The
    window leaves silently, so you stay where you are.
    """
    if not args:
        die("usage: omarchy-spaces move-to-space <space-id> [slot] [--follow]")
    target_space = args[0]
    if find_space(cfg, target_space) is None:
        die("no such space: %s (have: %s)" % (target_space, ", ".join(space_ids(cfg))))
    follow = "--follow" in args
    addr = arg_value(args, "--address")
    rest = [a for a in args[1:] if not a.startswith("--") and a != addr]

    active = read_active(cfg)
    if rest:
        try:
            slot = int(rest[0])
        except ValueError:
            die("slot must be a number")
    else:
        real = current_real_ws()
        slot = (real - ws_offset(cfg, active)) if real is not None else 1
        if not (1 <= slot <= ws_count(cfg, target_space)):
            slot = read_slot(target_space)

    count = ws_count(cfg, target_space)
    if not (1 <= slot <= count):
        die("space '%s' has slots 1 to %d" % (target_space, count))

    target = ws_offset(cfg, target_space) + slot
    ok, err = hypr(move_expr(target, follow=False, address=arg_value(args, "--address")))
    if not ok:
        die("hyprctl failed: %s" % err)
    print("moved to %s slot %d (real workspace %d)" % (target_space, slot, target))
    if follow:
        return cmd_switch(cfg, [target_space])
    return 0


def cmd_windows(cfg, args):
    """Show open windows grouped by the space that owns their workspace."""
    clients = hypr_json("clients")
    if clients is None:
        die("could not reach hyprctl")
    active = read_active(cfg)
    buckets = {sid: [] for sid in space_ids(cfg)}
    orphans = []
    for c in clients:
        try:
            real = int(c["workspace"]["id"])
        except Exception:
            continue
        placed = False
        for sid in space_ids(cfg):
            off = ws_offset(cfg, sid)
            if off < real <= off + ws_count(cfg, sid):
                buckets[sid].append((real - off, c))
                placed = True
                break
        if not placed:
            orphans.append((real, c))

    for sid in space_ids(cfg):
        space = find_space(cfg, sid)
        mark = "*" if sid == active else " "
        off = ws_offset(cfg, sid)
        print("%s %s (%s)  real workspaces %d-%d"
              % (mark, space.get("name") or sid, sid, off + 1, off + ws_count(cfg, sid)))
        if not buckets[sid]:
            print("      (no windows)")
        for slot, c in sorted(buckets[sid], key=lambda x: x[0]):
            print("      slot %-2d %-28s %s" % (slot, c.get("class", "?"), (c.get("title") or "")[:44]))
    if orphans:
        print("  outside every space range")
        for real, c in sorted(orphans):
            print("      ws %-3d %-28s %s" % (real, c.get("class", "?"), (c.get("title") or "")[:44]))
    return 0



# --- discovery ---------------------------------------------------------------
#
# Everything the config app needs to offer a real choice instead of a text box.
# Exposed on the CLI too, so the same lists are scriptable.

DESKTOP_DIRS = [
    os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"),
                 "applications"),
    "/usr/local/share/applications",
    "/usr/share/applications",
    os.path.expanduser("~/.nix-profile/share/applications"),
]

# Chromium-family browsers take --profile-directory and keep their profile list
# in a Local State JSON file. Firefox-family browsers use profiles.ini and a
# different flag entirely, so they are listed but offer no profiles here.
CHROMIUM_CONFIG_DIRS = {
    "brave": "BraveSoftware/Brave-Browser",
    "brave-browser": "BraveSoftware/Brave-Browser",
    "google-chrome-stable": "google-chrome",
    "google-chrome": "google-chrome",
    "google-chrome-beta": "google-chrome-beta",
    "google-chrome-unstable": "google-chrome-unstable",
    "chromium": "chromium",
    "microsoft-edge": "microsoft-edge",
    "microsoft-edge-stable": "microsoft-edge",
    "vivaldi": "vivaldi",
    "vivaldi-stable": "vivaldi",
    "opera": "opera",
    "thorium-browser": "thorium",
}


def parse_desktop(path):
    """Minimal .desktop reader. Only the [Desktop Entry] group."""
    out, in_entry = {}, False
    try:
        with open(path, errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if line.startswith("["):
                    in_entry = line == "[Desktop Entry]"
                    continue
                if not in_entry or "=" not in line or line.startswith("#"):
                    continue
                k, v = line.split("=", 1)
                out.setdefault(k.strip(), v.strip())
    except OSError:
        return None
    return out


def iter_desktop_entries():
    seen = set()
    for d in DESKTOP_DIRS:
        if not os.path.isdir(d):
            continue
        for name in sorted(os.listdir(d)):
            if not name.endswith(".desktop") or name in seen:
                continue
            seen.add(name)
            entry = parse_desktop(os.path.join(d, name))
            if entry:
                yield name, entry


def exec_command(entry):
    """First token of Exec, with field codes and quoting stripped."""
    raw = entry.get("Exec", "")
    for token in raw.split():
        if token.startswith("%"):
            continue
        return token.strip('"\'')
    return ""


def discover_browsers():
    """Installed browsers, one entry per executable.

    A single browser often has several desktop files, because per-profile
    launchers are a common thing to write. They all run the same executable, so
    they are grouped by it and the most canonical entry supplies the name: the
    one whose filename matches the command wins, then a system entry over a
    user one. Otherwise a launcher called "Brave, work profile" would end up
    labelling Brave itself.
    """
    groups = {}
    for name, entry in iter_desktop_entries():
        if entry.get("NoDisplay", "").lower() == "true":
            continue
        mimes = entry.get("MimeType", "")
        cats = entry.get("Categories", "")
        if "x-scheme-handler/https" not in mimes and "WebBrowser" not in cats:
            continue
        cmd = exec_command(entry)
        if not cmd:
            continue
        base = os.path.basename(cmd)
        stem = name[:-8] if name.endswith(".desktop") else name
        # Higher is more canonical.
        score = 0
        if stem == base:
            score += 4
        elif stem.startswith(base):
            score += 2
        if "--profile-directory" not in entry.get("Exec", ""):
            score += 1
        candidate = {"command": base,
                     "name": entry.get("Name", base),
                     "desktop": name,
                     "chromium": base in CHROMIUM_CONFIG_DIRS,
                     "_score": score}
        if base not in groups or score > groups[base]["_score"]:
            groups[base] = candidate

    out = []
    for base, entry in groups.items():
        entry.pop("_score", None)
        out.append(entry)
    out.sort(key=lambda b: b["name"].lower())
    return out


def discover_profiles(command):
    """Profiles for a chromium-family browser, newest activity first."""
    base = CHROMIUM_CONFIG_DIRS.get(os.path.basename(str(command or "")))
    if not base:
        return []
    state = os.path.join(CONFIG_HOME, base, "Local State")
    try:
        with open(state) as fh:
            cache = json.load(fh)["profile"]["info_cache"]
    except (OSError, KeyError, json.JSONDecodeError):
        return []
    # Local State can hold entries with no directory on disk, left behind by a
    # deleted profile or by a launcher passing a malformed --profile-directory.
    # Offering those as choices would create a fresh empty profile on launch.
    root = os.path.dirname(state)
    out = []
    for directory, info in cache.items():
        if not os.path.isdir(os.path.join(root, directory)):
            continue
        out.append({
            "directory": directory,
            "name": info.get("name") or directory,
            "email": info.get("user_name") or "",
            "active_time": info.get("active_time") or 0,
        })
    out.sort(key=lambda p: (-p["active_time"], p["directory"]))
    return out


def discover_apps():
    """Candidate app names for the `apps` list.

    Three sources, because notification senders do not always match a desktop
    file: installed .desktop entries, WM classes of open windows, and app names
    already seen in Omarchy's notification history. The last one is the most
    accurate, since it is literally what the app announced itself as.
    """
    seen, out = set(), []

    def add(value, source):
        v = str(value or "").strip()
        if not v or v.lower() in seen:
            return
        seen.add(v.lower())
        out.append({"name": v, "source": source})

    hist = os.path.join(STATE_HOME, "omarchy", "notifications", "history")
    if os.path.isdir(hist):
        files = sorted(os.listdir(hist), reverse=True)[:200]
        for f in files:
            try:
                with open(os.path.join(hist, f)) as fh:
                    add(json.load(fh).get("app"), "notification")
            except (OSError, json.JSONDecodeError):
                continue

    clients = hypr_json("clients") or []
    for c in clients:
        add(c.get("class"), "window")

    for name, entry in iter_desktop_entries():
        if entry.get("NoDisplay", "").lower() == "true":
            continue
        add(entry.get("StartupWMClass"), "desktop")
        add(entry.get("Name"), "desktop")

    return out


def discover_themes():
    ok, out = omarchy("theme", "list", timeout=15)
    return [l.strip() for l in out.splitlines() if l.strip()] if ok else []


def discover_fonts():
    ok, out = omarchy("font", "list", timeout=15)
    return [l.strip() for l in out.splitlines() if l.strip()] if ok else []


def discover_backgrounds():
    d = os.path.join(STATE_HOME, "omarchy", "current", "theme", "backgrounds")
    if not os.path.isdir(d):
        return []
    return sorted(f for f in os.listdir(d)
                  if f.lower().endswith((".png", ".jpg", ".jpeg", ".webp")))


def cmd_discover(cfg, args):
    what = args[0] if args else ""
    table = {
        "browsers": lambda: discover_browsers(),
        "profiles": lambda: discover_profiles(args[1] if len(args) > 1 else ""),
        "apps": lambda: discover_apps(),
        "themes": lambda: discover_themes(),
        "fonts": lambda: discover_fonts(),
        "backgrounds": lambda: discover_backgrounds(),
    }
    if what not in table:
        die("usage: omarchy-spaces discover <browsers|profiles <cmd>|apps|themes|fonts|backgrounds>")
    print(json.dumps(table[what](), indent=2))
    return 0


# --- import and export -------------------------------------------------------

def cmd_export(cfg, args):
    """Write the config out, to a file or stdout."""
    payload = json.dumps(cfg, indent=2) + "\n"
    target = next((a for a in args if not a.startswith("-")), None)
    if not target or target == "-":
        sys.stdout.write(payload)
        return 0
    target = os.path.expanduser(target)
    with open(target, "w") as fh:
        fh.write(payload)
    print("wrote %s" % target)
    return 0


def cmd_import(cfg, args):
    """Replace the config from a file or stdin, after validating it.

    The current config is backed up first, because this replaces everything.
    """
    source = next((a for a in args if not a.startswith("-")), None)
    try:
        raw = sys.stdin.read() if (not source or source == "-") \
            else open(os.path.expanduser(source)).read()
    except OSError as e:
        die("could not read: %s" % e)

    try:
        incoming = json.loads(raw)
    except json.JSONDecodeError as e:
        die("not valid JSON: %s" % e)

    if not isinstance(incoming.get("spaces"), list) or not incoming["spaces"]:
        die("that config has no spaces")
    for sp in incoming["spaces"]:
        if not isinstance(sp, dict) or not sp.get("id"):
            die("every space needs an id")

    backup = None
    if os.path.exists(CONFIG_PATH):
        backup = CONFIG_PATH + ".bak"
        with open(CONFIG_PATH) as src, open(backup, "w") as dst:
            dst.write(src.read())

    os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
    tmp = CONFIG_PATH + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(incoming, fh, indent=2)
        fh.write("\n")
    os.replace(tmp, CONFIG_PATH)

    print("imported %d spaces" % len(incoming["spaces"]))
    if backup:
        print("previous config saved to %s" % backup)
    return cmd_validate(incoming, [])



# --- keybinds ----------------------------------------------------------------
#
# Bindings live in the config and are written into a delimited block in
# ~/.config/hypr/bindings.lua. Owning a block rather than the whole file means
# a user's own bindings survive, and re-running replaces rather than appends.

BIND_BEGIN = "-- >>> omarchy-spaces managed block, do not edit by hand"
BIND_END = "-- <<< omarchy-spaces managed block"
BINDINGS_PATH = os.path.join(CONFIG_HOME, "hypr", "bindings.lua")

DEFAULT_KEYBINDS = {
    "workspaceNext": "SUPER + CTRL + RIGHT",
    "workspacePrev": "SUPER + CTRL + LEFT",
    "moveWindowNext": "SUPER + CTRL + SHIFT + RIGHT",
    "moveWindowPrev": "SUPER + CTRL + SHIFT + LEFT",
    "picker": "SUPER + ALT + O",
    "next": "SUPER + ALT + N",
    "prev": "SUPER + ALT + SHIFT + N",
    "status": "SUPER + ALT + I",
    "workspacePrefix": "SUPER",
    "moveWindowPrefix": "SUPER + SHIFT",
}

KEYBIND_LABELS = {
    "workspaceNext": "Next workspace in this space",
    "workspacePrev": "Previous workspace in this space",
    "moveWindowNext": "Move window to the next workspace",
    "moveWindowPrev": "Move window to the previous workspace",
    "picker": "Open the Spaces picker",
    "next": "Next space",
    "prev": "Previous space",
    "status": "Show the current policy",
    "workspacePrefix": "Go to workspace slot 1 to 10",
    "moveWindowPrefix": "Move the window to slot 1 to 10",
}


def keybinds(cfg):
    out = dict(DEFAULT_KEYBINDS)
    out.update(cfg.get("keybinds") or {})
    return out


def lua_quote(value):
    return '"' + str(value).replace("\\", "\\\\").replace('"', '\\"') + '"'


def keybind_block(cfg):
    kb = keybinds(cfg)
    lines = [BIND_BEGIN,
             "-- Written by `omarchy-spaces keybinds install`. Edit the bindings in the",
             "-- Omarchy Spaces app or in ~/.config/omarchy-spaces/spaces.json.",
             ""]

    def bind(combo, label, command):
        if not combo:
            return
        lines.append("o.bind(%s, %s, %s)" % (lua_quote(combo), lua_quote(label), lua_quote(command)))

    # Relative navigation, scoped to the active space. Hyprland's own e+1 and
    # e-1 walk every workspace on the machine, so a plain relative binding
    # escapes into another space's range. Unbind first: these keys usually
    # already hold something.
    for key, label, command in (
            ("workspaceNext", "Next workspace (this space)", "omarchy-spaces workspace next"),
            ("workspacePrev", "Previous workspace (this space)", "omarchy-spaces workspace prev"),
            ("moveWindowNext", "Move window to next workspace (this space)",
             "omarchy-spaces move-to-workspace next"),
            ("moveWindowPrev", "Move window to previous workspace (this space)",
             "omarchy-spaces move-to-workspace prev")):
        combo = kb.get(key)
        if combo:
            lines.append("hl.unbind(%s)" % lua_quote(combo))
            bind(combo, label, command)

    bind(kb.get("picker"), "Spaces picker", "omarchy menu summon spaces")
    bind(kb.get("next"), "Next space", "omarchy-spaces next")
    bind(kb.get("prev"), "Previous space", "omarchy-spaces prev")
    if kb.get("status"):
        lines.append("o.bind(%s, %s, %s)" % (
            lua_quote(kb["status"]), lua_quote("Space status"),
            lua_quote("bash -lc 'omarchy-notification-send \"$(omarchy-spaces status)\"'")))

    lines.append("")
    for space in cfg.get("spaces", []):
        sid = str(space.get("id"))
        name = space.get("name") or sid
        if space.get("keybind"):
            bind(space["keybind"], "Space: " + name, "omarchy-spaces switch " + sid)
        if space.get("sendKeybind"):
            bind(space["sendKeybind"], "Send window to " + name,
                 "omarchy-spaces move-to-space " + sid)

    if isolation_on(cfg) and (kb.get("workspacePrefix") or kb.get("moveWindowPrefix")):
        lines.append("")
        lines.append("-- Slots within the active space, not real workspace ids. This is what")
        lines.append("-- keeps a second space's range reachable without inventing new keys.")
        lines.append("for i = 1, 10 do")
        lines.append('  local key = "code:" .. tostring(i + 9)')
        if kb.get("workspacePrefix"):
            wp = kb["workspacePrefix"]
            lines.append('  hl.unbind(%s .. " + " .. key)' % lua_quote(wp))
            lines.append('  o.bind(%s .. " + " .. key, "Workspace " .. i .. " (this space)",'
                         % lua_quote(wp))
            lines.append('    "omarchy-spaces workspace " .. i)')
        if kb.get("moveWindowPrefix"):
            mp = kb["moveWindowPrefix"]
            lines.append('  hl.unbind(%s .. " + " .. key)' % lua_quote(mp))
            lines.append('  o.bind(%s .. " + " .. key, "Move window to workspace " .. i .. " (this space)",'
                         % lua_quote(mp))
            lines.append('    "omarchy-spaces move-to-workspace " .. i)')
        lines.append("end")

    # Replay startup layouts at login, for any space that asks for it. Off by
    # default: opening a dozen windows on login is not something to inherit
    # from having recorded a layout.
    if any((startup_config(cfg, sid).get("runOnLogin") is True) for sid in space_ids(cfg)):
        lines.append("")
        lines.append("-- Replay the active space's startup layout when Hyprland starts.")
        lines.append('o.exec_on_start("omarchy-spaces startup run --login")')

    rules = window_rule_lines(cfg)
    if rules:
        lines.append("")
        lines.extend(rules)

    lines.append(BIND_END)
    return "\n".join(lines)


def window_rule_lines(cfg):
    """Hyprland rules that park an app's windows in its owning space.

    This is what makes `apps` mean more than notification routing. Steam listed
    under personal opens on a personal workspace even if you launch it while
    work is active, so the segmentation holds without anything watching events
    at runtime.

    Rules are static config rather than a daemon reacting to window-open events.
    Hyprland places the window correctly the first time, so there is no visible
    jump, and nothing to keep running.
    """
    if not isolation_on(cfg):
        return []
    out = ["-- Park each app's windows in the space that owns it. Generated from the",
           "-- `apps` list of every space, so listing Steam under personal is enough.",
           "-- The `silent` suffix places the window without pulling you to it."]

    # Optional catch-all, emitted first so the specific rules below override it.
    # Off by default because it is genuinely far-reaching: every terminal,
    # editor, and file manager opened anywhere lands in the fallback space,
    # which is disruptive if you did not ask for it.
    fb = fallback_space(cfg)
    if fb and cfg.get("fallbackPlacesWindows") is True:
        out.append("-- Everything not named below opens in the fallback space.")
        out.append('o.window(%s, { workspace = %s })'
                   % (lua_quote(".*"), lua_quote("%d silent" % (ws_offset(cfg, fb) + 1))))

    seen = set()
    for sid in space_ids(cfg):
        resolved = resolve_space(cfg, sid)
        offset = ws_offset(cfg, sid)
        count = ws_count(cfg, sid)
        for entry in app_entries(resolved):
            cls = entry["cls"]
            if (not cls or cls in seen or not entry.get("windowRule", True)
                    or entry.get("shared")):
                continue
            seen.add(cls)
            slot = min(max(entry["slot"], 1), count)
            out.append('o.window(%s, { workspace = %s })'
                       % (lua_quote("^(" + cls + ")$"), lua_quote("%d silent" % (offset + slot))))
    return out if len(out) > 3 else []


def cmd_windowrules(cfg, args):
    sub = args[0] if args else "print"
    if sub == "print":
        lines = window_rule_lines(cfg)
        print("\n".join(lines) if lines else "no rules, no apps are listed")
        return 0
    if sub == "show":
        for sid in space_ids(cfg):
            resolved = resolve_space(cfg, sid)
            offset = ws_offset(cfg, sid)
            entries = app_entries(resolved)
            print("%s (real workspaces %d-%d)"
                  % (sid, offset + 1, offset + ws_count(cfg, sid)))
            if not entries:
                print("      no apps listed")
            for e in entries:
                print("      %-24s class=%-24s -> slot %d (real %d)"
                      % (e["name"], e["cls"], e["slot"], offset + e["slot"]))
        return 0
    die("usage: omarchy-spaces windowrules [print|show]")


def strip_block(text):
    out, skipping = [], False
    for line in text.splitlines():
        if line.strip() == BIND_BEGIN:
            skipping = True
            continue
        if line.strip() == BIND_END:
            skipping = False
            continue
        if not skipping:
            out.append(line)
    return "\n".join(out).rstrip() + "\n"


def hypr_reload():
    try:
        subprocess.run(["hyprctl", "reload"], capture_output=True, timeout=10)
        p = subprocess.run(["hyprctl", "configerrors"], capture_output=True, text=True, timeout=10)
        return (p.stdout or "").strip()
    except (OSError, subprocess.SubprocessError) as e:
        return str(e)


def cmd_keybinds(cfg, args):
    sub = args[0] if args else "show"

    if sub == "show":
        kb = keybinds(cfg)
        for key, label in KEYBIND_LABELS.items():
            combo = kb.get(key) or "(unset)"
            suffix = " + 1..0" if key.endswith("Prefix") and kb.get(key) else ""
            print("  %-34s %s%s" % (label, combo, suffix))
        for space in cfg.get("spaces", []):
            name = space.get("name") or space.get("id")
            if space.get("keybind"):
                print("  %-34s %s" % ("Switch to " + name, space["keybind"]))
            if space.get("sendKeybind"):
                print("  %-34s %s" % ("Send window to " + name, space["sendKeybind"]))
        installed = os.path.exists(BINDINGS_PATH) and BIND_BEGIN in open(BINDINGS_PATH).read()
        print()
        print("  block installed in %s: %s" % (BINDINGS_PATH, "yes" if installed else "no"))
        return 0

    if sub == "print":
        print(keybind_block(cfg))
        return 0

    if sub == "conflicts":
        return report_conflicts(cfg)

    if sub == "install":
        os.makedirs(os.path.dirname(BINDINGS_PATH), exist_ok=True)
        existing = open(BINDINGS_PATH).read() if os.path.exists(BINDINGS_PATH) else ""
        if existing:
            with open(BINDINGS_PATH + ".bak", "w") as fh:
                fh.write(existing)
        body = strip_block(existing)
        text = body + "\n" + keybind_block(cfg) + "\n"
        tmp = BINDINGS_PATH + ".tmp"
        with open(tmp, "w") as fh:
            fh.write(text)
        os.replace(tmp, BINDINGS_PATH)
        print("updated %s" % BINDINGS_PATH)
        errors = hypr_reload()
        if errors:
            print("hyprctl configerrors:")
            print(errors)
            return 1
        print("hyprland reloaded, no config errors")
        return 0

    if sub == "remove":
        if not os.path.exists(BINDINGS_PATH):
            print("nothing to remove")
            return 0
        with open(BINDINGS_PATH) as fh:
            text = fh.read()
        with open(BINDINGS_PATH, "w") as fh:
            fh.write(strip_block(text))
        print("removed the managed block from %s" % BINDINGS_PATH)
        hypr_reload()
        return 0

    die("usage: omarchy-spaces keybinds [show|print|install|remove|conflicts]")


def existing_bindings():
    """Every binding Omarchy currently knows about, normalised for comparison."""
    try:
        p = subprocess.run(["omarchy", "menu", "keybindings", "--print"],
                           capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return {}
    out = {}
    for line in (p.stdout or "").splitlines():
        if "\u2192" not in line:
            continue
        combo, _, desc = line.partition("\u2192")
        out[normalize_combo(combo)] = desc.strip()
    return out


def normalize_combo(combo):
    """SUPER + ALT + O and 'SUPER ALT + O' are the same binding."""
    parts = [p for p in str(combo).replace("+", " ").split() if p]
    if not parts:
        return ""
    mods = sorted(p.upper() for p in parts[:-1])
    return " ".join(mods + [parts[-1].upper()])


def report_conflicts(cfg):
    """Warn about bindings already taken by something that is not ours."""
    current = existing_bindings()
    ours = {}
    kb = keybinds(cfg)
    for key, label in KEYBIND_LABELS.items():
        if kb.get(key) and not key.endswith("Prefix"):
            ours[normalize_combo(kb[key])] = label
    for space in cfg.get("spaces", []):
        name = space.get("name") or space.get("id")
        if space.get("keybind"):
            ours[normalize_combo(space["keybind"])] = "Switch to " + name
        if space.get("sendKeybind"):
            ours[normalize_combo(space["sendKeybind"])] = "Send window to " + name

    clashes = []
    for combo, label in ours.items():
        held = current.get(combo)
        if held and "space" not in held.lower() and "Spaces" not in held:
            clashes.append((combo, label, held))

    seen = {}
    for combo, label in ours.items():
        if combo in seen:
            clashes.append((combo, label, "also " + seen[combo]))
        seen[combo] = label

    if not clashes:
        print("no conflicts")
        return 0
    for combo, label, held in clashes:
        print("warn: %s wanted for '%s' is taken by '%s'" % (combo, label, held))
    return 1



# --- startup layouts ---------------------------------------------------------
#
# A space can describe what each of its workspace slots should contain, and
# replay that on demand or at login.
#
#   "startup": {
#     "enabled": true,
#     "slots": [
#       { "slot": 1, "enabled": true, "layout": "split",
#         "entries": [ { "name": "Gmail", "command": "...", "match": "...",
#                        "enabled": true } ] }
#     ]
#   }
#
# layout is "split" (tiled side by side, Hyprland's default) or "stack" (one
# window group, so they share the space and you alternate with SUPER+ALT+TAB).
#
# `match` is a window class. When a window matching it is already on the slot,
# the entry is skipped, so running this twice does not open Gmail twice.

STARTUP_LAYOUTS = ("split", "stack")


def startup_config(cfg, space_id):
    space = resolve_space(cfg, space_id) or {}
    st = space.get("startup")
    return st if isinstance(st, dict) else {}


def startup_slots(cfg, space_id):
    st = startup_config(cfg, space_id)
    out = []
    for raw in (st.get("slots") or []):
        if not isinstance(raw, dict):
            continue
        try:
            slot = int(raw.get("slot", 0))
        except (TypeError, ValueError):
            continue
        if slot < 1:
            continue
        layout = str(raw.get("layout", "split")).lower()
        entries = []
        for e in (raw.get("entries") or []):
            if isinstance(e, str):
                e = {"command": e}
            if not isinstance(e, dict):
                continue
            command = str(e.get("command") or "")
            name = str(e.get("name") or (command.split()[0] if command else ""))
            if not command and not name:
                continue
            # An entry with no command is kept rather than dropped: capture
            # produces those for browser tabs, and the whole point is that you
            # can see them and fill in the URL. The runner skips them.
            entries.append({
                "name": name,
                "command": command,
                "match": str(e.get("match") or ""),
                "enabled": e.get("enabled") is not False and bool(command),
                "note": str(e.get("note") or ""),
            })
        out.append({
            "slot": slot,
            "enabled": raw.get("enabled") is not False,
            "layout": layout if layout in STARTUP_LAYOUTS else "split",
            "entries": entries,
        })
    return out


def clients_on(real_ws):
    data = hypr_json("clients") or []
    out = []
    for c in data:
        try:
            if int(c["workspace"]["id"]) == int(real_ws):
                out.append(c)
        except (KeyError, TypeError, ValueError):
            continue
    return out


def launch_command(command):
    try:
        subprocess.Popen(["setsid", "uwsm-app", "--"] + shlex.split(command),
                         stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        return True
    except (OSError, ValueError):
        return False


def wait_for_new_window(real_ws, known, timeout=12.0):
    """Wait for a window to appear on a workspace, return its address."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        for c in clients_on(real_ws):
            if c.get("address") and c["address"] not in known:
                return c["address"]
        time.sleep(0.3)
    return None


def group_windows(addresses):
    """Put windows into one Hyprland group, so they stack instead of tiling."""
    if len(addresses) < 2:
        return
    hypr('hl.dsp.focus({ window = "address:%s" })' % addresses[0])
    time.sleep(0.3)
    hypr("hl.dsp.group.toggle()")
    time.sleep(0.3)
    for addr in addresses[1:]:
        hypr('hl.dsp.focus({ window = "address:%s" })' % addr)
        time.sleep(0.2)
        hypr('hl.dsp.window.move({ into_group = "l" })')
        time.sleep(0.3)


def run_startup(cfg, space_id, only_slot=None, force=False, verbose=True):
    slots = startup_slots(cfg, space_id)
    st = startup_config(cfg, space_id)
    if st.get("enabled") is False and not force:
        if verbose:
            print("startup is disabled for %s" % space_id)
        return 0
    if not slots:
        if verbose:
            print("no startup layout for %s" % space_id)
        return 0

    offset = ws_offset(cfg, space_id)
    count = ws_count(cfg, space_id)
    started = 0
    for entry_slot in slots:
        if only_slot is not None and entry_slot["slot"] != only_slot:
            continue
        if not entry_slot["enabled"] and not force:
            if verbose:
                print("  slot %d: disabled" % entry_slot["slot"])
            continue

        real = offset + entry_slot["slot"]
        existing = {c["address"] for c in clients_on(real) if c.get("address")}

        # Look across the whole space, not just this slot. An app already open
        # on another of this space's workspaces should not be launched again:
        # moving an entry between slots would otherwise leave you with two, and
        # single-instance apps just raise the window they already have, so the
        # second launch produces nothing but confusion.
        present = set()
        for probe in range(1, count + 1):
            for c in clients_on(offset + probe):
                present.add(normalize_app_key(c.get("class")))
        opened = []

        # Focus the slot first so anything without a window rule lands here.
        hypr('hl.dsp.focus({ workspace = "%d" })' % real)
        time.sleep(0.4)

        for e in entry_slot["entries"]:
            if not e["enabled"] or not e["command"]:
                continue
            if e["match"] and normalize_app_key(e["match"]) in present:
                if verbose:
                    print("  slot %d: %s already open in this space"
                          % (entry_slot["slot"], e["name"]))
                continue
            if verbose:
                print("  slot %d: launching %s" % (entry_slot["slot"], e["name"]))
            if not launch_command(e["command"]):
                print("  slot %d: could not launch %s" % (entry_slot["slot"], e["name"]),
                      file=sys.stderr)
                continue
            addr = wait_for_new_window(real, existing)
            if addr:
                existing.add(addr)
                opened.append(addr)
                if e["match"]:
                    present.add(normalize_app_key(e["match"]))
                started += 1
            elif verbose:
                print("  slot %d: %s did not open a window in time"
                      % (entry_slot["slot"], e["name"]))

        if entry_slot["layout"] == "stack":
            group_windows([c["address"] for c in clients_on(real) if c.get("address")])

    return started


# --- capture -----------------------------------------------------------------

BROWSER_APP_CLASS = re.compile(r"^(chrome|brave)-(.+?)__-(.+)$")


def command_for_window(cfg, space_id, client):
    """Best effort launch command for an open window.

    Three cases, and only two of them are recoverable:

      a normal app          /proc/<pid>/cmdline is the command, use it
      a browser app window  the class encodes host and profile, rebuild it
      a browser tab         every window shares one browser process, so the
                            command says nothing about the page. Recorded with
                            a blank command for you to fill in.
    """
    cls = str(client.get("class") or "")
    title = str(client.get("title") or "")

    m = BROWSER_APP_CLASS.match(cls)
    if m:
        kind, hostpath, profile = m.groups()
        url = "https://" + hostpath.replace("_", "/").rstrip("/")
        space = resolve_space(cfg, space_id) or {}
        browser = (space.get("browser") or {}).get("command") or (
            "google-chrome-stable" if kind == "chrome" else "brave")
        prof = profile.replace("_", " ")
        return {
            "name": title or hostpath,
            "command": '%s --profile-directory="%s" --app=%s' % (browser, prof, url),
            "match": cls,
            "enabled": True,
        }

    pid = client.get("pid")
    argv = []
    if pid:
        try:
            with open("/proc/%d/cmdline" % int(pid), "rb") as fh:
                raw = fh.read().decode("utf-8", "replace")
            argv = [a for a in raw.split("\0") if a]
            # Normally cmdline is NUL separated, but some launchers leave it as
            # one space joined string. Omarchy's Chrome arrives that way, and
            # taking basename() of the whole line then yields the tail of a
            # --load-extension path rather than the browser.
            if len(argv) == 1 and " " in argv[0]:
                try:
                    argv = shlex.split(argv[0])
                except ValueError:
                    argv = argv[0].split()
        except (OSError, ValueError):
            argv = []

    # A browser window that is not an app window: one process, many windows, so
    # the command line describes the browser and not this page.
    if argv and normalize_app_key(os.path.basename(argv[0])) in {
            "chrome", "google-chrome", "google-chrome-stable", "brave", "brave-browser",
            "chromium", "firefox"}:
        return {
            "name": title[:60] or cls,
            "command": "",
            "match": cls,
            "enabled": False,
            "note": "browser tab, add the URL yourself",
        }

    if not argv:
        return {"name": title[:60] or cls, "command": "", "match": cls,
                "enabled": False, "note": "could not read the command"}

    return {
        "name": title[:60] or cls,
        "command": " ".join(shlex.quote(a) if " " in a else a for a in argv),
        "match": cls,
        "enabled": True,
    }


def cmd_startup(cfg, args):
    sub = args[0] if args else "show"
    rest = [a for a in args[1:] if not a.startswith("-")]
    space_id = rest[0] if rest and find_space(cfg, rest[0]) else read_active(cfg)

    if sub == "show":
        slots = startup_slots(cfg, space_id)
        st = startup_config(cfg, space_id)
        space = find_space(cfg, space_id) or {}
        print("%s (%s)  startup %s"
              % (space.get("name") or space_id, space_id,
                 "off" if st.get("enabled") is False else "on"))
        if not slots:
            print("  nothing recorded. Arrange a workspace, then:")
            print("    omarchy-spaces startup capture")
            return 0
        for sl in slots:
            print("  slot %-2d %-8s %s" % (sl["slot"], sl["layout"],
                                           "" if sl["enabled"] else "(disabled)"))
            for e in sl["entries"]:
                mark = " " if e["enabled"] else "x"
                detail = e["command"][:70] if e["command"] else (
                    "needs a command: " + (e["note"] or "unknown"))
                print("    [%s] %-26s %s" % (mark, e["name"][:26], detail))
        return 0

    if sub == "capture":
        slot_arg = None
        for a in args[1:]:
            if a.isdigit():
                slot_arg = int(a)
        offset = ws_offset(cfg, space_id)
        count = ws_count(cfg, space_id)
        real_now = current_real_ws()
        if slot_arg is None:
            if real_now is None or not (1 <= real_now - offset <= count):
                die("not on a workspace belonging to %s; pass a slot number" % space_id)
            slot_arg = real_now - offset

        real = offset + slot_arg
        clients = clients_on(real)
        if not clients:
            die("nothing open on slot %d of %s" % (slot_arg, space_id))

        entries = [command_for_window(cfg, space_id, c) for c in clients]
        space = find_space(cfg, space_id)
        st = space.setdefault("startup", {})
        st.setdefault("enabled", True)
        slots = st.setdefault("slots", [])
        slots[:] = [x for x in slots if int(x.get("slot", 0)) != slot_arg]
        slots.append({"slot": slot_arg, "enabled": True, "layout": "split",
                      "entries": entries})
        slots.sort(key=lambda x: int(x.get("slot", 0)))
        save_config_file(cfg)

        print("captured %d window(s) on slot %d of %s" % (len(entries), slot_arg, space_id))
        for e in entries:
            if e.get("note"):
                print("  %-26s %s" % (e["name"][:26], e["note"]))
            else:
                print("  %-26s %s" % (e["name"][:26], e["command"][:70]))
        incomplete = [e for e in entries if not e["command"]]
        if incomplete:
            print()
            print("%d entry(s) need a command. Browser tabs share one process, so the"
                  % len(incomplete))
            print("page cannot be read back from a running window. Add the URL in the")
            print("app under Startup, or make them app windows with --app=<url>.")
        return 0

    if sub == "run":
        only = None
        for a in args[1:]:
            if a.isdigit():
                only = int(a)
        if "--login" in args and startup_config(cfg, space_id).get("runOnLogin") is not True:
            return 0
        started = run_startup(cfg, space_id, only_slot=only, force="--force" in args)
        print("opened %d window(s)" % started)
        return 0

    if sub in ("enable", "disable"):
        space = find_space(cfg, space_id)
        st = space.setdefault("startup", {})
        target = None
        for a in args[1:]:
            if a.isdigit():
                target = int(a)
        if target is None:
            st["enabled"] = (sub == "enable")
            save_config_file(cfg)
            print("startup %sd for %s" % (sub, space_id))
            return 0
        for sl in st.get("slots") or []:
            if int(sl.get("slot", 0)) == target:
                sl["enabled"] = (sub == "enable")
                save_config_file(cfg)
                print("slot %d %sd for %s" % (target, sub, space_id))
                return 0
        die("slot %d has nothing recorded for %s" % (target, space_id))

    if sub == "forget":
        space = find_space(cfg, space_id)
        target = None
        for a in args[1:]:
            if a.isdigit():
                target = int(a)
        st = space.get("startup") or {}
        if target is None:
            space.pop("startup", None)
            save_config_file(cfg)
            print("cleared the startup layout for %s" % space_id)
            return 0
        st["slots"] = [x for x in (st.get("slots") or []) if int(x.get("slot", 0)) != target]
        save_config_file(cfg)
        print("forgot slot %d for %s" % (target, space_id))
        return 0

    die("usage: omarchy-spaces startup [show|capture|run|enable|disable|forget] [space] [slot]")


MENU_BEGIN = "  // >>> omarchy-spaces managed block, do not edit by hand"
MENU_END = "  // <<< omarchy-spaces managed block"
MENU_PATH = os.path.join(CONFIG_HOME, "omarchy", "extensions", "omarchy-menu.jsonc")


def menu_block(cfg):
    """Rows for the Omarchy menu, one per space, with the active one checked."""
    lines = [MENU_BEGIN]
    lines.append('  "spaces": {"icon":"\uf0c9","label":"Spaces"},')
    for s in cfg["spaces"]:
        sid = str(s["id"])
        icon = s.get("icon") or ""
        name = s.get("name") or sid
        desc = s.get("email") or ""
        lines.append(
            '  "spaces.%s": {"icon":"%s","label":"%s","description":"%s",'
            '"action":"omarchy-spaces switch %s",'
            '"checked":"[ \\"$(omarchy-spaces current)\\" = %s ]"},'
            % (sid, icon, name, desc, sid, sid)
        )
    # The bar widget opens this menu, so the way into the settings app belongs
    # here rather than behind a third mouse button nobody would guess.
    # `when` hides the row on a machine where the GTK app was not installed,
    # which install.sh skips when python-gobject or libadwaita are missing.
    lines.append('  "spaces.settings": {"icon":"\uf013","label":"Space settings",'
                 '"description":"Spaces, notification rules, keybinds",'
                 '"action":"uwsm-app -- omarchy-spaces-config",'
                 '"when":"command -v omarchy-spaces-config"},')
    lines.append(MENU_END)
    return "\n".join(lines)


def cmd_menu(cfg, args):
    print(menu_block(cfg))
    return 0


def cmd_install_menu(cfg, args):
    """Insert the space rows into the Omarchy menu extension file.

    The file is JSONC with comments the user may have written, so this splices
    a delimited block in rather than reserializing. Running it again replaces
    the previous block instead of duplicating it.
    """
    os.makedirs(os.path.dirname(MENU_PATH), exist_ok=True)
    if os.path.exists(MENU_PATH):
        text = open(MENU_PATH).read()
    else:
        text = "{\n}\n"

    lines = text.splitlines()
    out, skipping = [], False
    for line in lines:
        if line.strip() == MENU_BEGIN.strip():
            skipping = True
            continue
        if line.strip() == MENU_END.strip():
            skipping = False
            continue
        if not skipping:
            out.append(line)

    close = None
    for i in range(len(out) - 1, -1, -1):
        if out[i].strip() == "}":
            close = i
            break
    if close is None:
        die("could not find the closing brace in %s" % MENU_PATH)

    out[close:close] = menu_block(cfg).split("\n")
    tmp = MENU_PATH + ".tmp"
    with open(tmp, "w") as fh:
        fh.write("\n".join(out) + "\n")
    os.replace(tmp, MENU_PATH)
    print("updated %s" % MENU_PATH)
    return 0


def cmd_remove_menu(cfg, args):
    if not os.path.exists(MENU_PATH):
        print("nothing to remove")
        return 0
    lines = open(MENU_PATH).read().splitlines()
    out, skipping = [], False
    for line in lines:
        if line.strip() == MENU_BEGIN.strip():
            skipping = True
            continue
        if line.strip() == MENU_END.strip():
            skipping = False
            continue
        if not skipping:
            out.append(line)
    with open(MENU_PATH, "w") as fh:
        fh.write("\n".join(out) + "\n")
    print("removed the managed block from %s" % MENU_PATH)
    return 0


USAGE = """omarchy-spaces, context spaces for Omarchy

  list                    show every space, the active one is marked
  current [--json]        print the active space id
  switch <id>             make a space active
  next | prev             cycle through spaces
  status [--json]         show the notification policy in effect right now
  open <url>              open a url in the active space's browser profile
  which [url]             print the argv `open` would run, without running it
  get <field>             read a field off the active space
  init [--force]          write a starter config
  validate                check the config for gaps, overlaps, and bad refs
  read-file <config|active>  bounded read used by the shell plugin
  install-menu            add the space rows to the Omarchy menu
  remove-menu             take them back out
  menu                    print the menu rows without writing anything

Windows
  workspace <n|next|prev> go to a slot of the active space, staying in range
  move-to-workspace <n|next|prev>
                          move the focused window to a slot [--stay]
  move-to-space <id> [n]  send the focused window to another space [--follow]
                          [--address 0x..] targets one window instead of the focused one
  windows                 list open windows grouped by space

Appearance
  appearance show         the pinned look for the active space, and the live one
  appearance capture      save the current theme, font, and background to it
  appearance apply        re-apply the pinned look
  appearance clear        stop pinning a look for this space

Discovery and transfer
  discover <what>         browsers, profiles <cmd>, apps, themes, fonts, backgrounds
  export [path]           write the config out, stdout when no path
  import <path>           replace the config from a file, stdin when no path

Keybinds
  keybinds show           the bindings this config asks for
  keybinds install        write them into ~/.config/hypr/bindings.lua and reload
  keybinds remove         take the managed block back out
  keybinds conflicts      check them against what Hyprland already has
  keybinds print          print the Lua block without writing it
  windowrules show        which app lands in which space and slot
  windowrules print       the generated Hyprland rules

Startup layouts
  startup show [space]           what each slot opens
  startup capture [slot]         record what is open on a slot right now
  startup run [space] [slot]     open it, --login honours runOnLogin
  startup enable|disable [slot]  a whole space, or one slot
  startup forget [slot]          drop a slot, or the whole layout
"""


COMMANDS = {
    "list": cmd_list, "current": cmd_current, "switch": cmd_switch,
    "status": cmd_status, "open": cmd_open, "which": cmd_which,
    "get": cmd_get, "validate": cmd_validate, "menu": cmd_menu,
    "install-menu": cmd_install_menu, "remove-menu": cmd_remove_menu,
    "workspace": cmd_workspace, "move-to-workspace": cmd_move_to_workspace,
    "move-to-space": cmd_move_to_space, "windows": cmd_windows,
    "appearance": cmd_appearance, "discover": cmd_discover,
    "export": cmd_export, "import": cmd_import, "keybinds": cmd_keybinds,
    "read-file": cmd_read_file,
    "windowrules": cmd_windowrules, "startup": cmd_startup,
}


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return 0
    cmd, args = argv[0], argv[1:]
    if cmd == "init":
        return cmd_init(None, args)
    if cmd == "next":
        return cmd_cycle(load_config(), args, 1)
    if cmd == "prev":
        return cmd_cycle(load_config(), args, -1)
    fn = COMMANDS.get(cmd)
    if fn is None:
        die("unknown command: %s\n\n%s" % (cmd, USAGE))
    return fn(load_config(), args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
