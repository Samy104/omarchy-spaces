#!/usr/bin/env python3
"""Omarchy Spaces configuration app.

A GTK4 and libadwaita editor for ~/.config/omarchy-spaces/spaces.json.

Everything here is presentation. The policy rules live in bin/omarchy-spaces
and SpacesLogic.js, and this app shells out to `omarchy-spaces validate` rather
than reimplementing the checks a third time.
"""

import json
import os
import subprocess
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402

CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
CONFIG_PATH = os.path.join(CONFIG_HOME, "omarchy-spaces", "spaces.json")

DEFAULT_KEYBINDS = {
    "workspaceNext": "SUPER + CTRL + RIGHT",
    "workspacePrev": "SUPER + CTRL + LEFT",
    "moveWindowNext": "SUPER + CTRL + SHIFT + RIGHT",
    "moveWindowPrev": "SUPER + CTRL + SHIFT + LEFT",
    "picker": "SUPER + ALT + O",
    "next": "SUPER + ALT + N",
    "prev": "SUPER + ALT + SHIFT + N",
    "status": "SUPER + ALT + I",
    "workspacePrefix": "SUPER",
    "moveWindowPrefix": "SUPER + SHIFT",
}

PALETTE = ["#7aa2f7", "#9ece6a", "#e0af68", "#bb9af7", "#f7768e", "#7dcfff"]


def run_cli(*args):
    try:
        p = subprocess.run(["omarchy-spaces", *args], capture_output=True, text=True, timeout=15)
        return p.returncode, (p.stdout + p.stderr).strip()
    except (OSError, subprocess.SubprocessError) as e:
        return 1, str(e)



def run_cli_raw(program, *args):
    """Run any command and return (code, output). Used for `omarchy ...`."""
    try:
        p = subprocess.run([program, *args], capture_output=True, text=True, timeout=15)
        return p.returncode, (p.stdout + p.stderr).strip()
    except (OSError, subprocess.SubprocessError) as e:
        return 1, str(e)


def cli_json(*args):
    """Run a CLI subcommand that prints JSON and parse it."""
    code, out = run_cli(*args)
    if code != 0:
        return []
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        return []


def fill_combo(row, items, current, none_label="(none)"):
    """Populate an Adw.ComboRow and select `current`.

    A value already in the config that is not in the discovered list is added
    rather than dropped, so opening the app on a machine that is missing a
    browser or theme never silently rewrites the config.
    """
    values = [none_label] + list(items)
    cur = (current or "").strip()
    if cur and cur not in values:
        values.append(cur)
    model = Gtk.StringList.new(values)
    row.set_model(model)
    row.set_selected(values.index(cur) if cur in values else 0)
    return values


def combo_value(row, none_label="(none)"):
    item = row.get_selected_item()
    if item is None:
        return ""
    text = item.get_string()
    return "" if text == none_label else text


def load_config():
    if not os.path.exists(CONFIG_PATH):
        run_cli("init")
    try:
        with open(CONFIG_PATH) as fh:
            return json.load(fh)
    except (OSError, json.JSONDecodeError):
        return {"version": 1, "activeSpace": "", "criticalBypass": True, "spaces": []}


def save_config(cfg):
    os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
    tmp = CONFIG_PATH + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(cfg, fh, indent=2)
        fh.write("\n")
    os.replace(tmp, CONFIG_PATH)


def unique_id(cfg, base="space"):
    existing = {str(s.get("id")) for s in cfg.get("spaces", [])}
    if base not in existing:
        return base
    n = 2
    while "%s%d" % (base, n) in existing:
        n += 1
    return "%s%d" % (base, n)



# --- theming -----------------------------------------------------------------
#
# Omarchy writes the active theme to colors.toml, which is what the bar,
# terminals, and editors all read. The app reads the same file and overrides
# libadwaita's named colours, so it matches the desktop instead of sitting
# there in stock Adwaita while everything else is Ristretto or Catppuccin.
#
# The file is replaced wholesale on a theme change, and a space switch changes
# themes, so the directory is watched rather than the file: a rename swaps the
# inode out from under a file monitor.

THEME_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
    "omarchy", "current", "theme")
THEME_COLORS = os.path.join(THEME_DIR, "colors.toml")


def load_theme_colors():
    try:
        import tomllib
        with open(THEME_COLORS, "rb") as fh:
            return tomllib.load(fh)
    except (OSError, ImportError, ValueError):
        return None


def _luminance(hex_color):
    try:
        h = hex_color.lstrip("#")
        r, g, b = (int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))
    except (ValueError, IndexError):
        return 0.0

    def lin(c):
        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4

    return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b)


def _on(color):
    """Readable foreground for a filled button of this colour."""
    return "#000000" if _luminance(color) > 0.45 else "#ffffff"


def theme_css(c):
    """Map Omarchy's palette onto libadwaita's named colours."""
    get = lambda k, fallback: str(c.get(k) or fallback)
    bg = get("background", "#242424")
    fg = get("foreground", "#ffffff")
    dark_bg = get("dark_background", bg)
    darker_bg = get("darker_background", dark_bg)
    lighter_bg = get("lighter_background", bg)
    accent = get("accent", "#3584e4")
    muted = get("muted", fg)
    red = get("red", "#e01b24")
    green = get("green", "#2ec27e")
    yellow = get("yellow", "#e5a50a")

    pairs = {
        "window_bg_color": bg,
        "window_fg_color": fg,
        "view_bg_color": dark_bg,
        "view_fg_color": fg,
        "headerbar_bg_color": darker_bg,
        "headerbar_fg_color": fg,
        "headerbar_border_color": fg,
        "headerbar_backdrop_color": darker_bg,
        "sidebar_bg_color": darker_bg,
        "sidebar_fg_color": fg,
        "sidebar_backdrop_color": darker_bg,
        "sidebar_border_color": lighter_bg,
        "secondary_sidebar_bg_color": darker_bg,
        "secondary_sidebar_fg_color": fg,
        "card_bg_color": lighter_bg,
        "card_fg_color": fg,
        "dialog_bg_color": bg,
        "dialog_fg_color": fg,
        "popover_bg_color": dark_bg,
        "popover_fg_color": fg,
        "accent_bg_color": accent,
        "accent_fg_color": _on(accent),
        "accent_color": accent,
        "destructive_bg_color": red,
        "destructive_fg_color": _on(red),
        "destructive_color": red,
        "success_bg_color": green,
        "success_fg_color": _on(green),
        "success_color": green,
        "warning_bg_color": yellow,
        "warning_fg_color": _on(yellow),
        "warning_color": yellow,
        "error_bg_color": red,
        "error_fg_color": _on(red),
        "error_color": red,
    }
    css = "\n".join("@define-color %s %s;" % (k, v) for k, v in pairs.items())
    # Dim labels default to an opacity that disappears against some of these
    # backgrounds, so pin them to the theme's own muted colour instead.
    css += "\n.dim-label { color: %s; opacity: 1; }\n" % muted
    return css


class ThemeWatcher:
    """Applies the Omarchy palette and reapplies it when the theme changes."""

    def __init__(self):
        self.provider = Gtk.CssProvider()
        self.monitors = []
        self.applied = None

    def apply(self):
        colors = load_theme_colors()
        if not colors:
            return
        signature = json.dumps(colors, sort_keys=True)
        if signature == self.applied:
            return
        self.applied = signature

        display = Gdk.Display.get_default()
        if display is None:
            return
        try:
            self.provider.load_from_string(theme_css(colors))
        except AttributeError:
            self.provider.load_from_data(theme_css(colors).encode())
        Gtk.StyleContext.add_provider_for_display(
            display, self.provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        style = Adw.StyleManager.get_default()
        style.set_color_scheme(
            Adw.ColorScheme.FORCE_LIGHT if str(colors.get("mode", "dark")).lower() == "light"
            else Adw.ColorScheme.FORCE_DARK)

    def watch(self):
        self.apply()
        for path in (THEME_DIR, os.path.dirname(THEME_DIR)):
            try:
                monitor = Gio.File.new_for_path(path).monitor_directory(
                    Gio.FileMonitorFlags.NONE, None)
            except GLib.Error:
                continue
            monitor.connect("changed", lambda *_a: GLib.timeout_add(250, self._reapply))
            self.monitors.append(monitor)

    def _reapply(self):
        self.apply()
        return False


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Omarchy Spaces")
        self.set_default_size(940, 720)

        self.cfg = load_config()
        self.selected = 0
        self.dirty = False
        self.loading = False
        self.showing_general = None
        self.editing_defaults = False

        self.toast = Adw.ToastOverlay()
        self.set_content(self.toast)

        self.split = Adw.NavigationSplitView(min_sidebar_width=240, max_sidebar_width=300)
        self.toast.set_child(self.split)

        self.split.set_sidebar(self._build_sidebar())
        self.split.set_content(self._build_content())

        self.refresh_sidebar()
        self.load_selected()
        # Open on General. GTK selects the first focusable row when the window
        # is mapped, and General is that row, so this makes the landing page
        # deliberate rather than a side effect of widget order.
        self.general_list.select_row(self.general_list.get_row_at_index(0))

    # --- sidebar ------------------------------------------------------------

    def _build_sidebar(self):
        # Settings that belong to the whole config rather than one space, kept
        # above the list so it reads as a heading rather than a peer of the
        # spaces below it.
        self.general_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        self.general_list.add_css_class("navigation-sidebar")
        for title, subtitle, glyph in (
                ("General", "Settings for every space", "\u2699"),
                ("Defaults", "Inherited by every space", "\u21f2"),
                ("Keybinds", "Hyprland bindings", "\u2328")):
            row = Adw.ActionRow(title=title, subtitle=subtitle)
            icon = Gtk.Label(label=glyph)
            icon.add_css_class("title-3")
            row.add_prefix(icon)
            self.general_list.append(row)
        self.general_list.connect("row-selected", self.on_general_selected)

        heading = Gtk.Label(label="Spaces", xalign=0, margin_start=12,
                            margin_top=10, margin_bottom=4)
        heading.add_css_class("heading")
        heading.add_css_class("dim-label")

        self.space_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        self.space_list.add_css_class("navigation-sidebar")
        self.space_list.connect("row-selected", self.on_space_selected)

        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        inner.append(self.general_list)
        inner.append(heading)
        inner.append(self.space_list)

        scroll = Gtk.ScrolledWindow(vexpand=True, child=inner)

        add = Gtk.Button(icon_name="list-add-symbolic", tooltip_text="Add a space")
        add.connect("clicked", self.on_add_space)
        remove = Gtk.Button(icon_name="list-remove-symbolic", tooltip_text="Remove this space")
        remove.connect("clicked", self.on_remove_space)

        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6, margin_top=6,
                          margin_bottom=6, margin_start=6, margin_end=6)
        actions.append(add)
        actions.append(remove)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(scroll)
        box.append(Gtk.Separator())
        box.append(actions)

        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle(title="Omarchy Spaces"))

        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(header)
        toolbar.set_content(box)

        return Adw.NavigationPage(title="Spaces", child=toolbar)

    def refresh_sidebar(self):
        while (row := self.space_list.get_row_at_index(0)) is not None:
            self.space_list.remove(row)
        active_code, active = run_cli("current")
        active = active.strip() if active_code == 0 else ""
        for space in self.cfg.get("spaces", []):
            row = Adw.ActionRow(title=space.get("name") or space.get("id"),
                                subtitle=str(space.get("id")))
            icon = Gtk.Label(label=space.get("icon") or "●")
            icon.add_css_class("title-3")
            row.add_prefix(icon)
            marks = []
            if str(space.get("id")) == active:
                marks.append("active")
            if str(space.get("id")) == str(self.cfg.get("fallbackSpace", "")):
                marks.append("default")
            if marks:
                badge = Gtk.Label(label=" \u00b7 ".join(marks))
                badge.add_css_class("dim-label")
                badge.add_css_class("caption")
                badge.set_tooltip_text(
                    "active: the space you are in now\n"
                    "default: owns every app no space lists")
                row.add_suffix(badge)
            self.space_list.append(row)
        target = self.space_list.get_row_at_index(self.selected)
        if target:
            self.space_list.select_row(target)

    # --- content ------------------------------------------------------------

    def _build_content(self):
        self.page = Adw.PreferencesPage()

        self.g_identity = Adw.PreferencesGroup(title="Identity")
        self.r_id = Adw.EntryRow(title="Id")
        self.r_id.set_tooltip_text("Used by hotkeys, allowFrom, and the CLI. Renaming means "
                                   "updating those too.")
        self.r_name = Adw.EntryRow(title="Name")
        self.r_icon = Adw.EntryRow(title="Icon")
        self.r_icon.set_tooltip_text("A Nerd Font glyph. Paste it directly.")
        self.r_color = Adw.EntryRow(title="Color")
        for r in (self.r_id, self.r_name, self.r_icon, self.r_color):
            r.connect("changed", self.on_field_changed)
            self.g_identity.add(r)
        self.page.add(self.g_identity)

        self.g_browser = Adw.PreferencesGroup(
            title="Browser",
            description="Links open here while this space is active.")
        self.r_bcmd = Adw.ComboRow(title="Browser")
        self.r_bprofile = Adw.ComboRow(title="Profile")
        self.r_bprofile.set_subtitle("")
        self.r_bcmd.connect("notify::selected", self.on_browser_changed)
        self.r_bprofile.connect("notify::selected", self.on_field_changed)
        self.g_browser.add(self.r_bcmd)
        self.g_browser.add(self.r_bprofile)
        self.page.add(self.g_browser)

        self.g_accounts = Adw.PreferencesGroup(title="Accounts")
        self.r_email = Adw.EntryRow(title="Email")
        self.r_claude = Adw.EntryRow(title="Assistant: claude")
        self.r_codex = Adw.EntryRow(title="Assistant: codex")
        for r in (self.r_email, self.r_claude, self.r_codex):
            r.connect("changed", self.on_field_changed)
            self.g_accounts.add(r)
        self.page.add(self.g_accounts)

        self.g_apps = Adw.PreferencesGroup(
            title="Apps in this space",
            description="An app belongs to one space. Its notifications are routed here, "
                        "and its windows open on this space's workspaces.")
        add_app = Gtk.Button(icon_name="list-add-symbolic", valign=Gtk.Align.CENTER,
                             tooltip_text="Add an app")
        add_app.add_css_class("flat")
        add_app.connect("clicked", self.on_add_app)
        self.g_apps.set_header_suffix(add_app)
        self.page.add(self.g_apps)
        self.app_rows = []
        self.apps = []

        self.g_ws = Adw.PreferencesGroup(
            title="Workspaces",
            description="Each space owns a range of real Hyprland workspaces. "
                        "SUPER+1 means slot 1 of whichever space is active.")
        self.r_ws_range = Adw.ActionRow(title="Range", subtitle="")
        self.r_ws_count = Adw.SpinRow.new_with_range(1, 20, 1)
        self.r_ws_count.set_title("Slots")
        self.r_ws_count.connect("notify::value", self.on_field_changed)
        self.r_ws_offset = Adw.EntryRow(title="Offset override")
        self.r_ws_offset.set_tooltip_text("Leave empty to derive it from the space's "
                                          "position in the list.")
        self.r_ws_offset.connect("changed", self.on_field_changed)
        self.g_ws.add(self.r_ws_range)
        self.g_ws.add(self.r_ws_count)
        self.g_ws.add(self.r_ws_offset)
        self.page.add(self.g_ws)

        self.g_look = Adw.PreferencesGroup(
            title="Appearance",
            description="Applied on switch, so the active space is obvious at a glance.")
        capture = Gtk.Button(label="Capture current", valign=Gtk.Align.CENTER)
        capture.add_css_class("flat")
        capture.connect("clicked", self.on_capture_look)
        self.g_look.set_header_suffix(capture)
        self.r_theme = Adw.ComboRow(title="Theme")
        self.r_font = Adw.ComboRow(title="Font")
        self.r_bg = Adw.ComboRow(title="Background")
        self.r_bg.set_subtitle("From the current theme's backgrounds folder")
        for r in (self.r_theme, self.r_font, self.r_bg):
            r.connect("notify::selected", self.on_field_changed)
            self.g_look.add(r)
        self.page.add(self.g_look)

        self.g_startup = Adw.PreferencesGroup(
            title="Startup",
            description="What each workspace opens. Arrange a workspace how you like, "
                        "then capture it.")
        cap = Gtk.Button(label="Capture this workspace", valign=Gtk.Align.CENTER)
        cap.add_css_class("flat")
        cap.connect("clicked", self.on_capture_startup)
        self.g_startup.set_header_suffix(cap)
        self.page.add(self.g_startup)
        self.startup_rows = []

        self.g_notif = Adw.PreferencesGroup(
            title="Notifications",
            description="Baseline rules. Schedule windows below override these by time of day.")
        self.r_unassigned = Adw.SwitchRow(
            title="Show apps in no space",
            subtitle="Anything not listed under any space's apps")
        self.r_unassigned.connect("notify::active", self.on_field_changed)
        self.g_notif.add(self.r_unassigned)
        self.page.add(self.g_notif)

        self.g_allow = Adw.PreferencesGroup(title="Show notifications from")
        self.page.add(self.g_allow)
        self.allow_switches = {}

        self.g_sched = Adw.PreferencesGroup(title="Schedule")
        add_win = Gtk.Button(icon_name="list-add-symbolic", tooltip_text="Add a window",
                             valign=Gtk.Align.CENTER)
        add_win.add_css_class("flat")
        add_win.connect("clicked", self.on_add_window)
        self.g_sched.set_header_suffix(add_win)
        self.page.add(self.g_sched)
        self.window_rows = []

        save = Gtk.Button(label="Save")
        save.add_css_class("suggested-action")
        save.connect("clicked", self.on_save)

        validate = Gtk.Button(label="Validate")
        validate.connect("clicked", self.on_validate)

        header = Adw.HeaderBar()
        self.title_widget = Adw.WindowTitle(title="Omarchy Spaces", subtitle=CONFIG_PATH)
        header.set_title_widget(self.title_widget)
        menu = Gio.Menu()
        menu.append("Import configuration", "win.import")
        menu.append("Export configuration", "win.export")
        menu_button = Gtk.MenuButton(icon_name="open-menu-symbolic", menu_model=menu)

        header.pack_end(save)
        header.pack_end(validate)
        header.pack_end(menu_button)

        act = Gio.SimpleAction.new("import", None)
        act.connect("activate", lambda *_a: self.on_import(None))
        self.add_action(act)
        act = Gio.SimpleAction.new("export", None)
        act.connect("activate", lambda *_a: self.on_export(None))
        self.add_action(act)

        self.stack = Gtk.Stack()
        self.stack.add_named(self.page, "space")
        self.stack.add_named(self._build_general_page(), "general")
        self.stack.add_named(self._build_keybinds_page(), "keybinds")
        self.stack.set_visible_child_name("space")

        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(header)
        toolbar.set_content(self.stack)
        return Adw.NavigationPage(title="Edit", child=toolbar)

    def _build_general_page(self):
        """Settings that apply to the whole config, not to one space."""
        page = Adw.PreferencesPage()

        behaviour = Adw.PreferencesGroup(
            title="Behaviour",
            description="What a space switch actually changes.")

        self.g_isolation = Adw.SwitchRow(
            title="Isolate windows per space",
            subtitle="Each space owns a range of real Hyprland workspaces")
        self.g_appearance = Adw.SwitchRow(
            title="Apply appearance on switch",
            subtitle="Theme, font, and background pinned to the space")
        self.g_critical = Adw.SwitchRow(
            title="Let critical notifications through",
            subtitle="Low battery and disk full ignore space filtering")
        self.g_switch_notify = Adw.SwitchRow(
            title="Notify on switch",
            subtitle="A toast naming the space you moved to")
        for r in (self.g_isolation, self.g_appearance, self.g_critical, self.g_switch_notify):
            r.connect("notify::active", self.on_general_changed)
            behaviour.add(r)
        page.add(behaviour)

        default = Adw.PreferencesGroup(title="Spaces")

        self.g_fallback = Adw.ComboRow(
            title="Default space",
            subtitle="Owns every app no space lists. Only the exceptions need naming.")
        self.g_fallback.connect("notify::selected", self.on_general_changed)
        default.add(self.g_fallback)

        self.g_fallback_windows = Adw.SwitchRow(
            title="Open unlisted apps in the default space",
            subtitle="Far-reaching: every terminal, editor, and file manager lands "
                     "there too, wherever you launch it. Off unless you want that.")
        self.g_fallback_windows.connect("notify::active", self.on_general_changed)
        default.add(self.g_fallback_windows)

        self.g_default = Adw.ComboRow(
            title="Startup space",
            subtitle="Active on a fresh machine, before anything has been switched to.")
        self.g_default.connect("notify::selected", self.on_general_changed)
        default.add(self.g_default)
        page.add(default)

        menu = Adw.PreferencesGroup(
            title="Omarchy menu",
            description="Adds a Spaces submenu with one row per space, "
                        "reachable with SUPER + ALT + O.")
        add_row = Adw.ActionRow(title="Add the Spaces rows",
                                subtitle="Rewrites a delimited block, your own entries are untouched")
        add_btn = Gtk.Button(label="Install", valign=Gtk.Align.CENTER)
        add_btn.connect("clicked", lambda _b: self.run_and_toast("install-menu"))
        add_row.add_suffix(add_btn)
        remove_row = Adw.ActionRow(title="Remove them")
        remove_btn = Gtk.Button(label="Remove", valign=Gtk.Align.CENTER)
        remove_btn.add_css_class("destructive-action")
        remove_btn.connect("clicked", lambda _b: self.run_and_toast("remove-menu"))
        remove_row.add_suffix(remove_btn)
        menu.add(add_row)
        menu.add(remove_row)
        page.add(menu)

        transfer = Adw.PreferencesGroup(
            title="Configuration",
            description="The whole file, every space and every rule.")
        exp = Adw.ActionRow(title="Export", subtitle="Write this configuration to a file")
        exp_btn = Gtk.Button(label="Export", valign=Gtk.Align.CENTER)
        exp_btn.connect("clicked", self.on_export)
        exp.add_suffix(exp_btn)
        imp = Adw.ActionRow(title="Import",
                            subtitle="Replace everything, the current file is backed up first")
        imp_btn = Gtk.Button(label="Import", valign=Gtk.Align.CENTER)
        imp_btn.connect("clicked", self.on_import)
        imp.add_suffix(imp_btn)
        transfer.add(exp)
        transfer.add(imp)
        page.add(transfer)

        self.g_paths = Adw.PreferencesGroup(title="Files")
        self.g_paths.add(Adw.ActionRow(title="Configuration", subtitle=CONFIG_PATH))
        self.g_paths.add(Adw.ActionRow(
            title="Active space",
            subtitle=os.path.join(
                os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
                "omarchy-spaces", "active")))
        page.add(self.g_paths)

        return page

    def run_and_toast(self, *args):
        code, out = run_cli(*args)
        self.notify(out.splitlines()[0] if out else ("Done" if code == 0 else "Failed"))

    def load_general(self):
        self.loading = True
        try:
            self.g_isolation.set_active(self.cfg.get("workspaceIsolation") is not False)
            self.g_appearance.set_active(self.cfg.get("applyAppearance") is not False)
            self.g_critical.set_active(self.cfg.get("criticalBypass") is not False)
            self.g_switch_notify.set_active(self.cfg.get("switchNotification") is not False)
            ids = [str(s.get("id")) for s in self.cfg.get("spaces", []) if s.get("id")]
            fill_combo(self.g_default, ids, str(self.cfg.get("activeSpace", "")))
            fill_combo(self.g_fallback, ids, str(self.cfg.get("fallbackSpace", "")))
            self.g_fallback_windows.set_active(self.cfg.get("fallbackPlacesWindows") is True)
        finally:
            self.loading = False

    def collect_general(self):
        self.cfg["workspaceIsolation"] = self.g_isolation.get_active()
        self.cfg["applyAppearance"] = self.g_appearance.get_active()
        self.cfg["criticalBypass"] = self.g_critical.get_active()
        self.cfg["switchNotification"] = self.g_switch_notify.get_active()
        chosen = combo_value(self.g_default)
        if chosen:
            self.cfg["activeSpace"] = chosen
        else:
            self.cfg.pop("activeSpace", None)

        fallback = combo_value(self.g_fallback)
        if fallback:
            self.cfg["fallbackSpace"] = fallback
        else:
            self.cfg.pop("fallbackSpace", None)

        if self.g_fallback_windows.get_active():
            self.cfg["fallbackPlacesWindows"] = True
        else:
            self.cfg.pop("fallbackPlacesWindows", None)

    def on_general_changed(self, *_a):
        if self.loading:
            return
        self.dirty = True

    def on_general_selected(self, _list, row):
        if row is None or self.loading:
            return
        index = row.get_index()
        if self.showing_general == index:
            return
        self.collect()
        self.showing_general = index
        self.space_list.unselect_all()

        if index == 0:
            self.load_general()
            self.stack.set_visible_child_name("general")
            self.title_widget.set_title("General")
            self.title_widget.set_subtitle("Settings for every space")
        elif index == 1:
            # Defaults are edited with the space editor, minus identity. They
            # have the same shape, so duplicating the whole form would only
            # create two places for the same bug to live.
            self.editing_defaults = True
            self.g_identity.set_visible(False)
            self.load_selected()
            self.stack.set_visible_child_name("space")
            self.title_widget.set_title("Defaults")
            self.title_widget.set_subtitle("Every space inherits these unless it overrides them")
        else:
            self.load_keybinds()
            self.stack.set_visible_child_name("keybinds")
            self.title_widget.set_title("Keybinds")
            self.title_widget.set_subtitle("Written to ~/.config/hypr/bindings.lua")

    # --- data binding -------------------------------------------------------

    def current_space(self):
        if getattr(self, "editing_defaults", False):
            return self.cfg.setdefault("defaults", {})
        spaces = self.cfg.get("spaces", [])
        if not spaces:
            return None
        idx = max(0, min(self.selected, len(spaces) - 1))
        return spaces[idx]


    def show_page(self, page):
        """Select a sidebar entry by name, or a space by index."""
        page = str(page).strip().lower()
        if page in PAGES:
            row = self.general_list.get_row_at_index(PAGES.index(page))
            if row:
                self.general_list.select_row(row)
            return
        try:
            index = int(page)
        except ValueError:
            return
        row = self.space_list.get_row_at_index(index)
        if row:
            self.general_list.unselect_all()
            self.space_list.select_row(row)

    def inherited_for(self, space_id):
        """Which top-level keys this space takes from the defaults block."""
        defaults = self.cfg.get("defaults")
        if not isinstance(defaults, dict):
            return []
        space = next((s for s in self.cfg.get("spaces", [])
                      if str(s.get("id")) == space_id), None)
        if space is None:
            return []
        skip = ("id", "name", "icon", "color")
        return [k for k in defaults if k not in skip and k not in space]

    def load_selected(self):
        space = self.current_space()
        self.loading = True
        try:
            if space is None:
                for r in (self.r_id, self.r_name, self.r_icon, self.r_color,
                          self.r_email, self.r_claude, self.r_codex, self.r_ws_offset):
                    r.set_text("")
                self.set_apps([])
                self.rebuild_allow([])
                self.rebuild_windows([])
                return
            self.r_id.set_text(str(space.get("id", "")))
            self.r_name.set_text(str(space.get("name", "")))
            self.r_icon.set_text(str(space.get("icon", "")))
            self.r_color.set_text(str(space.get("color", "")))
            browser = space.get("browser") or {}
            self.browsers = cli_json("discover", "browsers")
            fill_combo(self.r_bcmd,
                       [b["command"] for b in self.browsers],
                       str(browser.get("command", "")))
            self.refresh_profiles(str(browser.get("profile", "")))
            self.r_email.set_text(str(space.get("email", "")))
            assistants = space.get("assistants") or {}
            self.r_claude.set_text(str(assistants.get("claude", "")))
            self.r_codex.set_text(str(assistants.get("codex", "")))
            self.set_apps(space.get("apps") or [])
            ws = space.get("workspaces") or {}
            count = int(ws.get("count", 10))
            self.r_ws_count.set_value(count)
            self.r_ws_offset.set_text(str(ws["offset"]) if "offset" in ws else "")
            idx = self.selected
            offset = int(ws["offset"]) if "offset" in ws else idx * count
            self.r_ws_range.set_subtitle("real workspaces %d to %d" % (offset + 1, offset + count))

            # Same widgets serve a space and the defaults block, so the copy
            # has to stop claiming to be about "this space" on the Defaults page.
            defaults_mode = getattr(self, "editing_defaults", False)
            is_fallback = (not defaults_mode
                           and str(space.get("id")) == str(self.cfg.get("fallbackSpace", "")))
            self.g_apps.set_title("Apps in every space" if defaults_mode else "Apps in this space")
            self.g_apps.set_description(
                "Claimed by any space that does not list its own. An app belongs to one "
                "space: its notifications are routed there, and its windows open there."
                if defaults_mode else
                ("This is the default space, so it already owns every app no other "
                 "space lists. Add one here only to pin which slot it opens on."
                 if is_fallback else
                 "An app belongs to one space. Its notifications are routed here, and "
                 "its windows open on this space's workspaces, wherever you launch it."))
            self.g_browser.set_description(
                "Used by any space that does not set its own."
                if defaults_mode else
                "Links open here while this space is active.")
            self.g_look.set_description(
                "Inherited by any space that pins no look of its own."
                if defaults_mode else
                "Applied on switch, so the active space is obvious at a glance.")
            self.g_notif.set_description(
                "Inherited baseline. A space overrides what it sets."
                if defaults_mode else
                "Baseline rules. Schedule windows below override these by time of day.")

            look = space.get("appearance") or {}
            fill_combo(self.r_theme, cli_json("discover", "themes"), str(look.get("theme", "")))
            fill_combo(self.r_font, cli_json("discover", "fonts"), str(look.get("font", "")))
            fill_combo(self.r_bg, cli_json("discover", "backgrounds"), str(look.get("background", "")))

            self.load_startup(space)

            notif = space.get("notifications") or {}
            fb = str(self.cfg.get("fallbackSpace", ""))
            self.r_unassigned.set_active(notif.get("allowUnassigned") is not False)
            self.r_unassigned.set_sensitive(not fb)
            self.r_unassigned.set_subtitle(
                ("No effect: %s is the default space, so nothing is unassigned"
                 % (self.cfg.get("fallbackSpace") or ""))
                if fb else "Anything not listed under any space's apps")
            self.rebuild_allow(notif.get("allowFrom") or [])
            self.rebuild_windows(notif.get("schedule") or [])
            if not defaults_mode:
                inherited = self.inherited_for(str(space.get("id")))
                self.title_widget.set_title(space.get("name") or str(space.get("id")))
                self.title_widget.set_subtitle(
                    ("inherits " + ", ".join(inherited) + " from Defaults")
                    if inherited else CONFIG_PATH)
        finally:
            self.loading = False

    def rebuild_allow(self, allowed):
        for row in list(self.allow_switches.values()):
            self.g_allow.remove(row)
        self.allow_switches = {}
        for other in self.cfg.get("spaces", []):
            sid = str(other.get("id"))
            row = Adw.SwitchRow(title=other.get("name") or sid, subtitle=sid)
            row.set_active(sid in allowed)
            row.connect("notify::active", self.on_field_changed)
            self.g_allow.add(row)
            self.allow_switches[sid] = row

    def rebuild_windows(self, windows):
        for row in self.window_rows:
            self.g_sched.remove(row["row"])
        self.window_rows = []
        for win in windows:
            self.add_window_row(win)
        if not windows:
            placeholder = Adw.ActionRow(
                title="No windows",
                subtitle="The baseline above applies all day. Add a window to vary by time.")
            placeholder.set_sensitive(False)
            self.g_sched.add(placeholder)
            self.window_rows.append({"row": placeholder, "placeholder": True})

    def add_window_row(self, win):
        for entry in list(self.window_rows):
            if entry.get("placeholder"):
                self.g_sched.remove(entry["row"])
                self.window_rows.remove(entry)

        expander = Adw.ExpanderRow()
        r_from = Adw.EntryRow(title="From (HH:MM)")
        r_to = Adw.EntryRow(title="To (HH:MM)")
        r_label = Adw.EntryRow(title="Label")
        r_from.set_text(str(win.get("from", "")))
        r_to.set_text(str(win.get("to", "")))
        r_label.set_text(str(win.get("label", "")))

        allow = win.get("allowFrom") or []
        switches = {}
        for other in self.cfg.get("spaces", []):
            sid = str(other.get("id"))
            sw = Adw.SwitchRow(title="Show " + (other.get("name") or sid), subtitle=sid)
            sw.set_active(sid in allow)
            switches[sid] = sw

        r_unassigned = Adw.SwitchRow(title="Show apps in no space")
        r_unassigned.set_active(win.get("allowUnassigned") is not False)

        remove = Gtk.Button(icon_name="user-trash-symbolic", valign=Gtk.Align.CENTER)
        remove.add_css_class("flat")
        expander.add_suffix(remove)

        for r in (r_from, r_to, r_label, *switches.values(), r_unassigned):
            expander.add_row(r)

        entry = {"row": expander, "from": r_from, "to": r_to, "label": r_label,
                 "switches": switches, "unassigned": r_unassigned}

        def retitle(*_):
            allowed = [s for s, sw in switches.items() if sw.get_active()]
            summary = ", ".join(allowed) if allowed else "nothing"
            expander.set_title("%s to %s" % (r_from.get_text() or "??:??",
                                             r_to.get_text() or "??:??"))
            expander.set_subtitle((r_label.get_text() + "  ") if r_label.get_text() else "")
            expander.set_subtitle((expander.get_subtitle() or "") + "shows " + summary)
            self.on_field_changed()

        for r in (r_from, r_to, r_label):
            r.connect("changed", retitle)
        for sw in (*switches.values(), r_unassigned):
            sw.connect("notify::active", retitle)

        def do_remove(_b):
            self.g_sched.remove(expander)
            self.window_rows.remove(entry)
            self.on_field_changed()
            if not self.window_rows:
                self.rebuild_windows([])

        remove.connect("clicked", do_remove)

        self.g_sched.add(expander)
        self.window_rows.append(entry)
        retitle()

    # --- collecting ---------------------------------------------------------

    def collect(self):
        if self.showing_general == 0:
            self.collect_general()
            return
        space = self.current_space()
        if space is None:
            return
        space["id"] = self.r_id.get_text().strip() or space.get("id")
        space["name"] = self.r_name.get_text().strip()
        space["icon"] = self.r_icon.get_text().strip()
        space["color"] = self.r_color.get_text().strip()

        cmd = combo_value(self.r_bcmd)
        if cmd:
            browser = space.get("browser") or {}
            browser["command"] = cmd
            profile = combo_value(self.r_bprofile)
            if profile:
                browser["profile"] = profile
            else:
                browser.pop("profile", None)
            space["browser"] = browser
        else:
            space.pop("browser", None)

        space["email"] = self.r_email.get_text().strip()
        assistants = {}
        if self.r_claude.get_text().strip():
            assistants["claude"] = self.r_claude.get_text().strip()
        if self.r_codex.get_text().strip():
            assistants["codex"] = self.r_codex.get_text().strip()
        if assistants:
            space["assistants"] = assistants
        else:
            space.pop("assistants", None)

        space["apps"] = list(self.apps)

        ws = space.get("workspaces") or {}
        ws["count"] = int(self.r_ws_count.get_value())
        offset_text = self.r_ws_offset.get_text().strip()
        if offset_text.isdigit():
            ws["offset"] = int(offset_text)
        else:
            ws.pop("offset", None)
        space["workspaces"] = ws

        look = {}
        if combo_value(self.r_theme):
            look["theme"] = combo_value(self.r_theme)
        if combo_value(self.r_font):
            look["font"] = combo_value(self.r_font)
        if combo_value(self.r_bg):
            look["background"] = combo_value(self.r_bg)
        if look:
            space["appearance"] = look
        else:
            space.pop("appearance", None)

        self.collect_startup(space)

        notif = space.get("notifications") or {}
        notif["allowFrom"] = [s for s, sw in self.allow_switches.items() if sw.get_active()]
        notif["allowUnassigned"] = self.r_unassigned.get_active()

        windows = []
        for entry in self.window_rows:
            if entry.get("placeholder"):
                continue
            win = {
                "from": entry["from"].get_text().strip(),
                "to": entry["to"].get_text().strip(),
                "allowFrom": [s for s, sw in entry["switches"].items() if sw.get_active()],
                "allowUnassigned": entry["unassigned"].get_active(),
            }
            if entry["label"].get_text().strip():
                win["label"] = entry["label"].get_text().strip()
            windows.append(win)
        if windows:
            notif["schedule"] = windows
        else:
            notif.pop("schedule", None)
        space["notifications"] = notif

    # --- events -------------------------------------------------------------

    def on_field_changed(self, *_a):
        if self.loading:
            return
        self.dirty = True

    def on_space_selected(self, _list, row):
        if row is None or self.loading:
            return
        idx = row.get_index()
        if idx == self.selected and self.showing_general is None:
            return
        if self.showing_general is not None:
            self.collect()
            self.showing_general = None
            self.editing_defaults = False
            self.g_identity.set_visible(True)
            self.general_list.unselect_all()
            self.stack.set_visible_child_name("space")
        else:
            self.collect()
        self.selected = idx
        self.load_selected()
        self.title_widget.set_subtitle(CONFIG_PATH)

    def on_add_space(self, _b):
        self.collect()
        sid = unique_id(self.cfg)
        color = PALETTE[len(self.cfg["spaces"]) % len(PALETTE)]
        self.cfg.setdefault("spaces", []).append({
            "id": sid, "name": "New space", "icon": "●", "color": color,
            "apps": [], "notifications": {"allowFrom": [sid], "allowUnassigned": True},
        })
        self.selected = len(self.cfg["spaces"]) - 1
        self.refresh_sidebar()
        self.load_selected()
        self.dirty = True

    def on_remove_space(self, _b):
        space = self.current_space()
        if space is None:
            return
        if len(self.cfg.get("spaces", [])) <= 1:
            self.notify("Keep at least one space")
            return
        dialog = Adw.MessageDialog(
            transient_for=self, heading="Remove this space?",
            body="%s will be deleted. Other spaces referencing it in allowFrom will be "
                 "cleaned up too." % (space.get("name") or space.get("id")))
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("remove", "Remove")
        dialog.set_response_appearance("remove", Adw.ResponseAppearance.DESTRUCTIVE)

        def answered(_d, response):
            if response != "remove":
                return
            sid = str(space.get("id"))
            self.cfg["spaces"].remove(space)
            for other in self.cfg["spaces"]:
                notif = other.get("notifications") or {}
                if sid in (notif.get("allowFrom") or []):
                    notif["allowFrom"] = [x for x in notif["allowFrom"] if x != sid]
                for win in notif.get("schedule") or []:
                    if sid in (win.get("allowFrom") or []):
                        win["allowFrom"] = [x for x in win["allowFrom"] if x != sid]
            self.selected = max(0, self.selected - 1)
            self.refresh_sidebar()
            self.load_selected()
            self.dirty = True

        dialog.connect("response", answered)
        dialog.present()

    def on_add_window(self, _b):
        self.add_window_row({"from": "09:00", "to": "17:00", "allowFrom": [], "label": ""})
        self.dirty = True

    def on_save(self, _b):
        self.collect()
        save_config(self.cfg)
        self.dirty = False
        code, out = run_cli("validate")
        run_cli("install-menu")
        self.refresh_sidebar()
        if code == 0:
            self.notify("Saved. " + out)
        else:
            self.notify("Saved with warnings, see Validate")



    # --- keybinds -----------------------------------------------------------

    KEYBIND_FIELDS = [
        ("picker", "Open the Spaces picker", "omarchy menu summon spaces"),
        ("workspaceNext", "Next workspace in this space", "Wraps inside the space's range"),
        ("workspacePrev", "Previous workspace in this space", "Wraps inside the space's range"),
        ("moveWindowNext", "Move window to the next workspace", ""),
        ("moveWindowPrev", "Move window to the previous workspace", ""),
        ("next", "Next space", ""),
        ("prev", "Previous space", ""),
        ("status", "Show the current policy", ""),
        ("workspacePrefix", "Workspace slot 1 to 10", "The number key is appended"),
        ("moveWindowPrefix", "Move window to slot 1 to 10", "The number key is appended"),
    ]

    def _build_keybinds_page(self):
        page = Adw.PreferencesPage()

        self.g_binds = Adw.PreferencesGroup(
            title="Global",
            description="Click a binding to record a new one.")
        self.bind_rows = {}
        for key, label, hint in self.KEYBIND_FIELDS:
            row = Adw.ActionRow(title=label, subtitle=hint)
            btn = Gtk.Button(valign=Gtk.Align.CENTER)
            btn.add_css_class("flat")
            btn.connect("clicked", lambda _b, k=key, l=label: self.capture_bind(k, l))
            row.add_suffix(btn)
            row.set_activatable_widget(btn)
            self.g_binds.add(row)
            self.bind_rows[key] = btn
        page.add(self.g_binds)

        self.g_space_binds = Adw.PreferencesGroup(
            title="Per space",
            description="Switch to a space, and send the focused window to it.")
        page.add(self.g_space_binds)
        self.space_bind_rows = []

        actions = Adw.PreferencesGroup(
            title="Apply",
            description="Bindings are written to a delimited block. Your own bindings "
                        "in that file are left alone.")

        check = Adw.ActionRow(title="Check for conflicts",
                              subtitle="Against everything Hyprland already has bound")
        check_btn = Gtk.Button(label="Check", valign=Gtk.Align.CENTER)
        check_btn.connect("clicked", self.on_check_binds)
        check.add_suffix(check_btn)

        write = Adw.ActionRow(title="Write and reload",
                              subtitle="Applies immediately, then reports any config errors")
        write_btn = Gtk.Button(label="Apply", valign=Gtk.Align.CENTER)
        write_btn.add_css_class("suggested-action")
        write_btn.connect("clicked", self.on_write_binds)
        write.add_suffix(write_btn)

        remove = Adw.ActionRow(title="Remove the block",
                               subtitle="Leaves Hyprland's own bindings in place")
        remove_btn = Gtk.Button(label="Remove", valign=Gtk.Align.CENTER)
        remove_btn.add_css_class("destructive-action")
        remove_btn.connect("clicked",
                           lambda _b: self.run_and_toast("keybinds", "remove"))
        remove.add_suffix(remove_btn)

        actions.add(check)
        actions.add(write)
        actions.add(remove)
        page.add(actions)
        return page

    def load_keybinds(self):
        self.loading = True
        try:
            kb = dict(DEFAULT_KEYBINDS)
            kb.update(self.cfg.get("keybinds") or {})
            for key, btn in self.bind_rows.items():
                btn.set_label(kb.get(key) or "unset")

            for row in self.space_bind_rows:
                self.g_space_binds.remove(row)
            self.space_bind_rows = []
            for space in self.cfg.get("spaces", []):
                sid = str(space.get("id"))
                name = space.get("name") or sid
                for field, verb in (("keybind", "Switch to "), ("sendKeybind", "Send window to ")):
                    row = Adw.ActionRow(title=verb + name, subtitle=sid)
                    btn = Gtk.Button(label=space.get(field) or "unset", valign=Gtk.Align.CENTER)
                    btn.add_css_class("flat")
                    btn.connect("clicked",
                                lambda _b, s=space, f=field, t=verb + name: self.capture_bind(f, t, s))
                    row.add_suffix(btn)
                    row.set_activatable_widget(btn)
                    self.g_space_binds.add(row)
                    self.space_bind_rows.append(row)
        finally:
            self.loading = False

    def capture_bind(self, key, label, space=None):
        """Record the next chord the user presses.

        Typing "SUPER + ALT + O" into a text box is the part of this that
        nobody enjoys, so the dialog listens for a real key press instead.
        """
        dialog = Adw.MessageDialog(
            transient_for=self, heading=label,
            body="Press the combination now.\nEscape cancels, Backspace clears it.")
        dialog.add_response("cancel", "Cancel")

        MODS = [(Gdk.ModifierType.SUPER_MASK, "SUPER"),
                (Gdk.ModifierType.CONTROL_MASK, "CTRL"),
                (Gdk.ModifierType.ALT_MASK, "ALT"),
                (Gdk.ModifierType.SHIFT_MASK, "SHIFT")]
        IGNORED = {Gdk.KEY_Super_L, Gdk.KEY_Super_R, Gdk.KEY_Control_L, Gdk.KEY_Control_R,
                   Gdk.KEY_Alt_L, Gdk.KEY_Alt_R, Gdk.KEY_Shift_L, Gdk.KEY_Shift_R,
                   Gdk.KEY_ISO_Level3_Shift, Gdk.KEY_Meta_L, Gdk.KEY_Meta_R}

        def on_key(_c, keyval, _code, state):
            if keyval == Gdk.KEY_Escape:
                dialog.close()
                return True
            if keyval in IGNORED:
                return True

            if keyval == Gdk.KEY_BackSpace:
                combo = ""
            else:
                parts = [name for mask, name in MODS if state & mask]
                # A prefix binding is only modifiers, the number key is added
                # by the generated Lua loop.
                if key.endswith("Prefix"):
                    if not parts:
                        return True
                    combo = " + ".join(parts)
                else:
                    name = Gdk.keyval_name(Gdk.keyval_to_upper(keyval))
                    if not name:
                        return True
                    combo = " + ".join(parts + [name.upper()])

            if space is not None:
                if combo:
                    space[key] = combo
                else:
                    space.pop(key, None)
            else:
                binds = self.cfg.setdefault("keybinds", {})
                if combo:
                    binds[key] = combo
                else:
                    binds.pop(key, None)

            self.dirty = True
            dialog.close()
            self.load_keybinds()
            return True

        controller = Gtk.EventControllerKey()
        controller.connect("key-pressed", on_key)
        dialog.add_controller(controller)
        dialog.present()

    def on_check_binds(self, _b):
        save_config(self.cfg)
        code, out = run_cli("keybinds", "conflicts")
        d = Adw.MessageDialog(transient_for=self,
                              heading="No conflicts" if code == 0 else "Conflicts",
                              body=out or "No output")
        d.add_response("ok", "Close")
        d.present()

    def on_write_binds(self, _b):
        save_config(self.cfg)
        code, out = run_cli("keybinds", "install")
        if code == 0:
            self.notify("Bindings applied, Hyprland reloaded")
        else:
            d = Adw.MessageDialog(transient_for=self, heading="Hyprland reported errors",
                                  body=out or "No output")
            d.add_response("ok", "Close")
            d.present()


    # --- startup layouts ----------------------------------------------------

    def load_startup(self, space):
        for row in self.startup_rows:
            self.g_startup.remove(row)
        self.startup_rows = []
        self.startup = space.get("startup") or {}
        slots = list(self.startup.get("slots") or [])
        slots.sort(key=lambda x: int(x.get("slot", 0)))
        self.startup["slots"] = slots

        toggle = Adw.SwitchRow(
            title="Layout enabled",
            subtitle="Turn off to keep the layout without replaying it")
        toggle.set_active(self.startup.get("enabled") is not False)
        toggle.connect("notify::active", self.on_field_changed)
        self.g_startup.add(toggle)
        self.startup_rows.append(toggle)
        self.startup_enabled_row = toggle

        login = Adw.SwitchRow(
            title="Open automatically at login",
            subtitle="Replays this layout when Hyprland starts, if this space is "
                     "the active one. Needs Keybinds, Apply to take effect.")
        login.set_active(self.startup.get("runOnLogin") is True)
        login.connect("notify::active", self.on_field_changed)
        self.g_startup.add(login)
        self.startup_rows.append(login)
        self.startup_login_row = login

        if not slots:
            empty = Adw.ActionRow(
                title="Nothing recorded",
                subtitle="Go to a workspace in this space, open what you want, "
                         "then use Capture this workspace")
            empty.set_sensitive(False)
            self.g_startup.add(empty)
            self.startup_rows.append(empty)
            return

        for index, sl in enumerate(slots):
            self.g_startup.add(self.startup_slot_row(index, sl, len(slots)))

    def startup_slot_row(self, index, sl, total):
        slot_no = int(sl.get("slot", 0))
        entries = sl.get("entries") or []
        live = sum(1 for e in entries if e.get("command"))
        layout = str(sl.get("layout", "split"))

        row = Adw.ExpanderRow(
            title="Workspace %d" % slot_no,
            subtitle="%s, %d of %d ready" % (
                "side by side" if layout == "split" else "stacked, alternate with SUPER+ALT+TAB",
                live, len(entries)))

        on = Gtk.Switch(valign=Gtk.Align.CENTER, active=sl.get("enabled") is not False)
        on.connect("notify::active", lambda w, _p, s=sl: self.set_startup_flag(s, w))
        row.add_suffix(on)

        up = Gtk.Button(icon_name="go-up-symbolic", valign=Gtk.Align.CENTER)
        up.add_css_class("flat")
        up.set_sensitive(index > 0)
        up.connect("clicked", lambda _b, i=index: self.move_startup_slot(i, -1))
        down = Gtk.Button(icon_name="go-down-symbolic", valign=Gtk.Align.CENTER)
        down.add_css_class("flat")
        down.set_sensitive(index < total - 1)
        down.connect("clicked", lambda _b, i=index: self.move_startup_slot(i, 1))
        row.add_prefix(down)
        row.add_prefix(up)

        mode = Adw.ComboRow(title="Arrangement")
        fill_combo(mode, ["split", "stack"], layout, none_label="split")
        mode.connect("notify::selected",
                     lambda w, _p, s=sl: self.set_startup_layout(s, w))
        row.add_row(mode)

        for e in entries:
            sub = e.get("command") or ("needs a command: " + (e.get("note") or "unknown"))
            er = Adw.ActionRow(title=e.get("name") or "(unnamed)", subtitle=sub[:90])
            er.set_activatable(True)
            er.connect("activated", lambda _r, entry=e: self.edit_startup_entry(entry))
            sw = Gtk.Switch(valign=Gtk.Align.CENTER,
                            active=e.get("enabled") is not False and bool(e.get("command")))
            sw.set_sensitive(bool(e.get("command")))
            sw.connect("notify::active", lambda w, _p, entry=e: self.set_startup_flag(entry, w))
            er.add_suffix(sw)
            row.add_row(er)

        run = Adw.ActionRow(title="Open this workspace now")
        btn = Gtk.Button(label="Run", valign=Gtk.Align.CENTER)
        btn.connect("clicked", lambda _b, n=slot_no: self.run_startup_slot(n))
        run.add_suffix(btn)
        row.add_row(run)

        drop = Adw.ActionRow(title="Forget this workspace")
        dbtn = Gtk.Button(label="Forget", valign=Gtk.Align.CENTER)
        dbtn.add_css_class("destructive-action")
        dbtn.connect("clicked", lambda _b, n=slot_no: self.forget_startup_slot(n))
        drop.add_suffix(dbtn)
        row.add_row(drop)

        self.startup_rows.append(row)
        return row

    def set_startup_flag(self, target, switch):
        if self.loading:
            return
        target["enabled"] = switch.get_active()
        self.dirty = True

    def set_startup_layout(self, sl, combo):
        if self.loading:
            return
        sl["layout"] = combo_value(combo, none_label="split") or "split"
        self.dirty = True
        self.refresh_startup()

    def move_startup_slot(self, index, step):
        slots = self.startup.get("slots") or []
        target = index + step
        if not (0 <= target < len(slots)):
            return
        slots[index], slots[target] = slots[target], slots[index]
        self.dirty = True
        self.refresh_startup()

    def forget_startup_slot(self, slot_no):
        slots = self.startup.get("slots") or []
        self.startup["slots"] = [x for x in slots if int(x.get("slot", 0)) != slot_no]
        self.dirty = True
        self.refresh_startup()

    def refresh_startup(self):
        space = self.current_space()
        if space is None:
            return
        self.collect_startup(space)
        save_config(self.cfg)
        self.cfg = load_config()
        self.load_selected()

    def collect_startup(self, space):
        if not getattr(self, "startup", None):
            return
        if hasattr(self, "startup_enabled_row"):
            self.startup["enabled"] = self.startup_enabled_row.get_active()
        if hasattr(self, "startup_login_row"):
            if self.startup_login_row.get_active():
                self.startup["runOnLogin"] = True
            else:
                self.startup.pop("runOnLogin", None)
        if self.startup.get("slots"):
            space["startup"] = self.startup
        else:
            space.pop("startup", None)

    def run_startup_slot(self, slot_no):
        space = self.current_space()
        if space is None:
            return
        self.collect()
        save_config(self.cfg)
        code, out = run_cli("startup", "run", str(space.get("id")), str(slot_no))
        self.notify(out.splitlines()[-1] if out else ("Opened" if code == 0 else "Failed"))

    def on_capture_startup(self, _b):
        space = self.current_space()
        if space is None:
            return
        code, active = run_cli("current")
        if code == 0 and active.strip() != str(space.get("id")):
            self.notify("Switch to this space first, capture reads the workspace you are on")
            return
        self.collect()
        save_config(self.cfg)
        code, out = run_cli("startup", "capture")
        self.cfg = load_config()
        self.load_selected()
        self.notify(out.splitlines()[0] if out else "Captured")

    def edit_startup_entry(self, entry):
        dialog = Adw.MessageDialog(transient_for=self,
                                   heading=entry.get("name") or "Entry",
                                   body="The command that opens this window.")
        group = Adw.PreferencesGroup()
        r_name = Adw.EntryRow(title="Name")
        r_name.set_text(str(entry.get("name") or ""))
        r_cmd = Adw.EntryRow(title="Command")
        r_cmd.set_text(str(entry.get("command") or ""))
        r_match = Adw.EntryRow(title="Window class")
        r_match.set_text(str(entry.get("match") or ""))
        r_match.set_tooltip_text("Used to skip this entry when its window is already open")
        for r in (r_name, r_cmd, r_match):
            group.add(r)
        dialog.set_extra_child(group)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("save", "Save")
        dialog.set_default_response("save")

        def answered(_d, response):
            if response != "save":
                return
            entry["name"] = r_name.get_text().strip()
            entry["command"] = r_cmd.get_text().strip()
            entry["match"] = r_match.get_text().strip()
            if entry["command"]:
                entry.pop("note", None)
                entry["enabled"] = True
            self.dirty = True
            self.refresh_startup()

        dialog.connect("response", answered)
        dialog.present()

    # --- profiles, apps, transfer -------------------------------------------

    def refresh_profiles(self, current=""):
        """Repopulate the profile list for whichever browser is selected.

        Firefox-family browsers do not take --profile-directory, so the row is
        disabled rather than offering choices that would not work.
        """
        cmd = combo_value(self.r_bcmd)
        entry = next((b for b in getattr(self, "browsers", []) if b["command"] == cmd), None)
        if not cmd:
            fill_combo(self.r_bprofile, [], "")
            self.r_bprofile.set_sensitive(False)
            self.r_bprofile.set_subtitle("Pick a browser first")
            return
        if entry is not None and not entry.get("chromium", False):
            fill_combo(self.r_bprofile, [], "")
            self.r_bprofile.set_sensitive(False)
            self.r_bprofile.set_subtitle("This browser does not support --profile-directory")
            return

        profiles = cli_json("discover", "profiles", cmd)
        labels = [p["directory"] for p in profiles]
        fill_combo(self.r_bprofile, labels, current)
        self.r_bprofile.set_sensitive(True)
        if profiles:
            described = ", ".join("%s is %s" % (p["directory"], p["name"]) for p in profiles[:3])
            self.r_bprofile.set_subtitle(described)
        else:
            self.r_bprofile.set_subtitle("No profiles found, has this browser been run?")

    def on_browser_changed(self, *_a):
        if self.loading:
            return
        self.refresh_profiles(combo_value(self.r_bprofile))
        self.on_field_changed()

    def set_apps(self, apps):
        for row in self.app_rows:
            self.g_apps.remove(row)
        self.app_rows = []
        self.apps = list(apps)
        if not self.apps:
            row = Adw.ActionRow(title="No apps",
                                subtitle="Unlisted apps fall to the default space")
            row.set_sensitive(False)
            self.g_apps.add(row)
            self.app_rows.append(row)
            return
        for index, raw in enumerate(self.apps):
            entry = self.app_entry(raw)
            if entry["shared"]:
                detail = "shared, reaches every space"
            elif entry["windowRule"]:
                detail = "opens on slot %d" % entry["slot"]
                if entry["cls"] != entry["name"]:
                    detail += ", window class %s" % entry["cls"]
            else:
                detail = "notifications only, windows left where they open"
            row = Adw.ActionRow(title=entry["name"], subtitle=detail)
            row.set_activatable(True)
            row.connect("activated", lambda _r, i=index: self.edit_app(i))
            btn = Gtk.Button(icon_name="user-trash-symbolic", valign=Gtk.Align.CENTER)
            btn.add_css_class("flat")
            btn.connect("clicked", lambda _b, i=index: self.remove_app_at(i))
            row.add_suffix(btn)
            self.g_apps.add(row)
            self.app_rows.append(row)

    @staticmethod
    def app_entry(raw):
        """Mirror of app_entry in the CLI, for display."""
        if isinstance(raw, str):
            return {"name": raw, "cls": raw, "slot": 1, "windowRule": True, "shared": False}
        name = str(raw.get("name") or raw.get("class") or "")
        try:
            slot = int(raw.get("slot", 1))
        except (TypeError, ValueError):
            slot = 1
        return {"name": name,
                "cls": str(raw.get("class") or name),
                "slot": slot if slot > 0 else 1,
                "windowRule": raw.get("windowRule") is not False,
                "shared": raw.get("shared") is True}

    def remove_app_at(self, index):
        if 0 <= index < len(self.apps):
            del self.apps[index]
        self.set_apps(self.apps)
        self.on_field_changed()

    def edit_app(self, index):
        """Which slot an app opens on, and whether it is placed at all.

        A browser is the case that needs the opt-out: every profile shares one
        window class, so a placement rule would drag them all into one space.
        """
        if not (0 <= index < len(self.apps)):
            return
        entry = self.app_entry(self.apps[index])

        dialog = Adw.MessageDialog(transient_for=self, heading=entry["name"],
                                   body="How this app is treated in this space.")
        group = Adw.PreferencesGroup()
        r_class = Adw.EntryRow(title="Window class")
        r_class.set_text(entry["cls"])
        r_slot = Adw.SpinRow.new_with_range(1, 20, 1)
        r_slot.set_title("Opens on slot")
        r_slot.set_value(entry["slot"])
        r_place = Adw.SwitchRow(
            title="Place its windows",
            subtitle="Turn off for a browser, whose profiles share one class")
        r_place.set_active(entry["windowRule"])
        r_shared = Adw.SwitchRow(
            title="Shared across spaces",
            subtitle="Belongs to no space. Its notifications always reach you and "
                     "its windows are never moved. Use it for a music player.")
        r_shared.set_active(entry["shared"])
        for r in (r_class, r_slot, r_place, r_shared):
            group.add(r)
        dialog.set_extra_child(group)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("save", "Save")
        dialog.set_default_response("save")

        def answered(_d, response):
            if response != "save":
                return
            new_entry = {"name": entry["name"]}
            cls = r_class.get_text().strip()
            if cls and cls != entry["name"]:
                new_entry["class"] = cls
            slot = int(r_slot.get_value())
            if slot != 1:
                new_entry["slot"] = slot
            if not r_place.get_active():
                new_entry["windowRule"] = False
            if r_shared.get_active():
                new_entry["shared"] = True
            # A plain string is the tidier form when nothing was customised.
            self.apps[index] = (new_entry["name"] if list(new_entry) == ["name"]
                                else new_entry)
            self.set_apps(self.apps)
            self.on_field_changed()

        dialog.connect("response", answered)
        dialog.present()

    def on_add_app(self, _b):
        """Searchable picker over apps this machine actually knows about.

        Names seen in notification history come first, because that is literally
        what the app announced itself as, which is what the matching uses.
        """
        candidates = cli_json("discover", "apps")
        taken = {self.app_entry(a)["name"].lower() for a in self.apps}
        candidates = [c for c in candidates if c["name"].lower() not in taken]

        win = Adw.Window(transient_for=self, modal=True, title="Add an app",
                         default_width=460, default_height=520)
        search = Gtk.SearchEntry(placeholder_text="Search apps", hexpand=True)
        listbox = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        listbox.add_css_class("boxed-list")
        listbox.set_margin_start(12)
        listbox.set_margin_end(12)
        listbox.set_margin_bottom(12)

        SOURCE_LABEL = {"notification": "seen in notifications",
                        "window": "open window",
                        "desktop": "installed"}

        def choose(name):
            if name and name.lower() not in {self.app_entry(a)["name"].lower() for a in self.apps}:
                self.apps.append(name)
                self.set_apps(self.apps)
                self.on_field_changed()
            win.close()

        for c in candidates:
            row = Adw.ActionRow(title=c["name"], subtitle=SOURCE_LABEL.get(c["source"], ""))
            row.set_activatable(True)
            row.connect("activated", lambda _r, n=c["name"]: choose(n))
            listbox.append(row)

        def do_filter(row):
            text = search.get_text().strip().lower()
            return not text or text in row.get_title().lower()

        listbox.set_filter_func(do_filter)
        search.connect("search-changed", lambda _e: listbox.invalidate_filter())

        def add_typed(_e):
            text = search.get_text().strip()
            if text:
                choose(text)

        search.connect("activate", add_typed)

        header = Adw.HeaderBar()
        header.set_title_widget(search)

        scroll = Gtk.ScrolledWindow(vexpand=True, child=listbox)
        hint = Gtk.Label(
            label="Not listed? Type the name and press Enter.",
            margin_top=6, margin_bottom=10)
        hint.add_css_class("dim-label")
        hint.add_css_class("caption")

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(scroll)
        box.append(hint)

        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(header)
        toolbar.set_content(box)
        win.set_content(toolbar)
        win.present()

    def on_export(self, _b):
        self.collect()
        save_config(self.cfg)
        chooser = Gtk.FileDialog(title="Export configuration",
                                 initial_name="omarchy-spaces.json")

        def done(dialog, result):
            try:
                gfile = dialog.save_finish(result)
            except GLib.Error:
                return
            code, out = run_cli("export", gfile.get_path())
            self.notify(out if code else "Exported to " + gfile.get_path())

        chooser.save(self, None, done)

    def on_import(self, _b):
        chooser = Gtk.FileDialog(title="Import configuration")

        def done(dialog, result):
            try:
                gfile = dialog.open_finish(result)
            except GLib.Error:
                return
            code, out = run_cli("import", gfile.get_path())
            if code not in (0, 1):
                self.notify(out.splitlines()[0] if out else "Import failed")
                return
            self.cfg = load_config()
            self.selected = 0
            self.refresh_sidebar()
            self.load_selected()
            run_cli("install-menu")
            self.notify("Imported. Previous config saved as spaces.json.bak")

        chooser.open(self, None, done)

    def on_capture_look(self, _b):
        """Save whatever the desktop looks like right now into this space.

        Only meaningful for the space that is currently active, since the theme
        on screen belongs to it.
        """
        space = self.current_space()
        if space is None:
            return

        # The CLI's capture writes into the active space. On the Defaults page
        # there is no active space to write to, so read the current look here
        # rather than refusing with a confusing message about switching.
        if getattr(self, "editing_defaults", False):
            look = {}
            for key, sub in (("theme", "theme"), ("font", "font")):
                code, out = run_cli_raw("omarchy", sub, "current")
                if code == 0 and out:
                    look[key] = out.splitlines()[0].strip()
            state = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
            link = os.path.join(state, "omarchy", "current", "background")
            bgdir = os.path.join(state, "omarchy", "current", "theme", "backgrounds")
            try:
                real = os.path.realpath(link)
                if os.path.exists(real):
                    look["background"] = (os.path.basename(real)
                                          if os.path.dirname(real) == bgdir else real)
            except OSError:
                pass
            if not look:
                self.notify("Could not read the current theme")
                return
            self.collect()
            space["appearance"] = look
            self.load_selected()
            self.dirty = True
            self.notify("Captured into Defaults: " + ", ".join(look))
            return

        code, active = run_cli("current")
        if code == 0 and active.strip() != str(space.get("id")):
            self.notify("Switch to this space first, the look on screen belongs to "
                        + active.strip())
            return
        self.collect()
        save_config(self.cfg)
        rc, out = run_cli("appearance", "capture")
        self.cfg = load_config()
        self.load_selected()
        self.notify("Captured the current theme, font, and background" if rc == 0 else out)

    def on_validate(self, _b):
        self.collect()
        save_config(self.cfg)
        self.dirty = False
        code, out = run_cli("validate")
        dialog = Adw.MessageDialog(
            transient_for=self,
            heading="Config is valid" if code == 0 else "Warnings",
            body=out or "No output")
        dialog.add_response("ok", "Close")
        dialog.present()

    def notify(self, text):
        self.toast.add_toast(Adw.Toast(title=text, timeout=3))


class App(Adw.Application):
    def __init__(self, start_page=None):
        super().__init__(application_id="org.omarchy.Spaces",
                         flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.start_page = start_page

    def do_activate(self):
        if not hasattr(self, "theme"):
            self.theme = ThemeWatcher()
            self.theme.watch()
        win = self.props.active_window or Window(self)
        win.present()
        if self.start_page:
            # After present, and on an idle callback: GTK selects the first
            # focusable row when the window is mapped, which would override a
            # selection made before that.
            GLib.idle_add(lambda: (win.show_page(self.start_page), False)[1])


PAGES = ("general", "defaults", "keybinds")

USAGE = """omarchy-spaces-config, configure Omarchy Spaces

  --page <general|defaults|keybinds|N>
        Open on a particular page. N is a zero-based index into the space list.
        Used for documentation screenshots and for launchers that want to land
        somewhere specific.
"""


def main(argv):
    if "-h" in argv or "--help" in argv:
        print(USAGE)
        return 0
    page = None
    if "--page" in argv:
        i = argv.index("--page")
        if i + 1 < len(argv):
            page = argv[i + 1]
            del argv[i:i + 2]
    return App(page).run(argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
